# ─────────────────────────────────────────────────────────────
# open-infra — keep the repo public-safe. NOTHING private here.
# This repo is destined to become a public open-source project,
# so anything describing a specific deployment, LAN, or secret
# must stay OUT of git and live only in a local (ignored) config.
# ─────────────────────────────────────────────────────────────

# --- Local site/deployment config (the ONLY place real values live) ---
config.yaml
config.local.yaml
*.local.yaml
/site/
/sites/

# --- Internal LAN / private infra descriptions ---
# Anything that names real hosts, subnets, NAS paths, or node inventories.
# NOTE: these are anchored to the repo root with a leading slash so they only
# match a top-level private dir — they must NOT swallow Go `internal/` packages
# in subprojects like console-api/internal/.
inventory.yaml
inventory.ini
hosts.yaml
/lan/
/internal/
/private/
*.private
*.internal.yaml

# --- Secrets & credentials (never commit) ---
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.p12
*.pfx
secrets/
sealed-secrets-key*
*-key.yaml
credentials*
*token*
!*/templates/*token*       # allow Helm templates that reference tokens by name

# --- Kubernetes / cluster state ---
kubeconfig
*.kubeconfig
.kube/
k3s.yaml
*.tfstate
*.tfstate.*
.terraform/

# --- Cloudflare / WireGuard / tunnel material ---
cloudflared/
*.tunnel.json
wg*.conf
*.wgkey

# --- Claude / agent + editor local state ---
.claude/
.claude.json
*.swp
.DS_Store
.idea/
.vscode/

# --- Build / language artifacts ---
bin/
dist/
node_modules/
__pycache__/
*.pyc

# Go build artifacts: `go build ./...` in apply-sink/ emits a binary named after the
# module (applysink). It's an 18MB ELF — never commit it; CI builds via Docker.
apply-sink/applysink
# Same for a stray `go build ./cmd/aws-shim/` in console-api/ (the shim binary).
console-api/aws-shim
console-api/console-api

# go build inside a cmd/ directory writes a binary named after it
console-api/cmd/apigw-validator/apigw-validator
console-api/cmd/attest/attest
console-api/cmd/audit-offsite/audit-offsite
console-api/cmd/authz-webhook/authz-webhook
console-api/cmd/aws-shim/aws-shim
console-api/cmd/ca-issuer/ca-issuer
console-api/cmd/corpus-check/corpus-check
console-api/cmd/rbac-to-cedar/rbac-to-cedar
console-api/cmd/server/server
