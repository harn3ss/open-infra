# open-infra apigw-validator — the API Gateway request-validation tier. A tiny reverse proxy that
# validates HttpApi routes' request Model (JSON Schema) + required parameters at the gateway and
# returns a 400 before the backend (the faithful API Gateway request-validation behavior). Lives in
# the console-api Go module (shares nothing security-sensitive, but keeps one module/build). Builds
# only ./cmd/apigw-validator — a small static binary on distroless. Build context is the repo ROOT
# because console-api requires the sibling modules via local replaces.
FROM golang:1.27 AS build
ARG GOFIPS140=v1.0.0   # amd64 default; build-arm64 overrides to empty (non-FIPS arm64)
ENV GOFIPS140=${GOFIPS140}
WORKDIR /src
COPY dynamodb/ dynamodb/
COPY policyengine/ policyengine/
COPY cfn/ cfn/
COPY console-api/go.mod console-api/go.sum console-api/
WORKDIR /src/console-api
RUN go mod download
COPY console-api/ ./
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /apigw-validator ./cmd/apigw-validator

FROM gcr.io/distroless/static-debian12
ARG OPENINFRA_FIPS=true   # amd64 default; build-arm64 sets false via the label
LABEL openinfra.dev/fips=${OPENINFRA_FIPS}
EXPOSE 8080
USER 65532:65532
COPY --from=build /apigw-validator /apigw-validator
ENTRYPOINT ["/apigw-validator"]
