# open-infra attest — assembles a compliance attestation (control coverage + live evidence) from the
# cluster and writes it as JSON + Markdown for signing. Lives in the console-api module so it shares
# internal/attest with the console's read-only view — one assembler, so the signed artifact and the
# on-screen report are the same. Small static binary on distroless, like audit-offsite/aws-shim.
# Build context is console-api/.
FROM golang:1.26 AS build
ARG GOFIPS140=v1.0.0   # Go native FIPS 140-3 module — amd64 default; build-arm64 overrides to empty (non-FIPS arm64)
ENV GOFIPS140=${GOFIPS140}
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /attest ./cmd/attest

FROM gcr.io/distroless/static-debian12
ARG OPENINFRA_FIPS=true   # amd64 default; build-arm64 sets false via the label
LABEL openinfra.dev/fips=${OPENINFRA_FIPS}
USER 65532:65532
COPY --from=build /attest /attest
ENTRYPOINT ["/attest"]
