# open-infra audit-offsite — ships the API-server audit log to a WORM object store as a
# hash-chained, tamper-evident sequence, and verifies that chain (NIST AU-9 / AU-9(2)/(3) / AU-10).
#
# It lives in the console-api Go module so it shares internal/auditchain with the console's
# integrity endpoint — ONE chain implementation, verified identically on both sides. This image
# builds only ./cmd/audit-offsite: a small static binary on distroless, like aws-shim/apply-sink.
# Build context is the repo ROOT — console-api requires the shared dynamodb and policyengine
# modules via local replaces (../dynamodb, ../policyengine), so those siblings are copied in beside it.
FROM golang:1.26 AS build
ARG GOFIPS140=v1.0.0   # Go native FIPS 140-3 module — amd64 default; build-arm64 overrides to empty (non-FIPS arm64)
ENV GOFIPS140=${GOFIPS140}
WORKDIR /src
COPY dynamodb/ dynamodb/
COPY policyengine/ policyengine/
COPY console-api/go.mod console-api/go.sum console-api/
WORKDIR /src/console-api
RUN go mod download
COPY console-api/ ./
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /audit-offsite ./cmd/audit-offsite

FROM gcr.io/distroless/static-debian12
ARG OPENINFRA_FIPS=true   # amd64 default; build-arm64 sets false via the label
LABEL openinfra.dev/fips=${OPENINFRA_FIPS}
USER 65532:65532
COPY --from=build /audit-offsite /audit-offsite
ENTRYPOINT ["/audit-offsite"]
