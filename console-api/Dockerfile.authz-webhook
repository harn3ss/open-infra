# open-infra authz-webhook — the Cedar control-plane authorization webhook (Phase 2).
#
# It implements the Kubernetes authorization-webhook contract (a SubjectAccessReview in, an
# allow/deny/no-opinion out) and decides via the Cedar policy engine over kind: Policy
# spec.controlPlane. It lives in the console-api Go module (reuses policyengine + internal/iam), so
# it rebuilds on console-api changes. Small static binary on distroless, like aws-shim.
#
# Build context is the repo ROOT — console-api requires the shared dynamodb and policyengine
# modules via local replaces (../dynamodb, ../policyengine), so those siblings are copied in beside it.
FROM golang:1.26 AS build
ARG GOFIPS140=v1.0.0   # Go native FIPS 140-3 module — amd64 default; build-arm64 overrides to empty
ENV GOFIPS140=${GOFIPS140}
WORKDIR /src
COPY dynamodb/ dynamodb/
COPY policyengine/ policyengine/
COPY console-api/go.mod console-api/go.sum console-api/
WORKDIR /src/console-api
RUN go mod download
COPY console-api/ ./
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /authz-webhook ./cmd/authz-webhook

FROM gcr.io/distroless/static-debian12
ARG OPENINFRA_FIPS=true
LABEL openinfra.dev/fips=${OPENINFRA_FIPS}
# 8443 is the webhook's TLS port (the API server connects here over HTTPS).
EXPOSE 8443
USER 65532:65532
COPY --from=build /authz-webhook /authz-webhook
ENTRYPOINT ["/authz-webhook"]
