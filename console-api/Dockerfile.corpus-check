# open-infra corpus-check — audits the control-plane authorization corpus (Cedar grants derived from
# live RBAC) for cluster-admin sprawl, wildcard permissions, cluster-wide secret reads, and escalation
# verbs. It is the machine-checkable replacement for the CIS Kubernetes Benchmark RBAC controls once
# Cedar is the base grantor (CA-2/CA-7). Lives in the console-api module (shares internal/corpuscheck
# + internal/rbactocedar). Small static binary on distroless, like attest/aws-shim.
# Build context is the repo ROOT (console-api needs the sibling dynamodb/policyengine modules).
FROM golang:1.26 AS build
ARG GOFIPS140=v1.0.0   # Go native FIPS 140-3 module — amd64 default; build-arm64 overrides to empty
ENV GOFIPS140=${GOFIPS140}
WORKDIR /src
COPY dynamodb/ dynamodb/
COPY policyengine/ policyengine/
COPY console-api/go.mod console-api/go.sum console-api/
WORKDIR /src/console-api
RUN go mod download
COPY console-api/ ./
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /corpus-check ./cmd/corpus-check

FROM gcr.io/distroless/static-debian12
ARG OPENINFRA_FIPS=true
LABEL openinfra.dev/fips=${OPENINFRA_FIPS}
USER 65532:65532
COPY --from=build /corpus-check /corpus-check
ENTRYPOINT ["/corpus-check"]
