<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- NetVersion is the .NET the host targets: 8.0 (dotnet8, the default) or 10.0 (dotnet10). A property,
         not -p:TargetFramework, so restore and build agree on it (the Dockerfile passes NET_VERSION). -->
    <NetVersion Condition="'$(NetVersion)' == ''">8.0</NetVersion>
    <TargetFramework>net$(NetVersion)</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>bootstrap</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The bucket (S3/MinIO) code-source path. The inline-ConfigMap path never touches it. PINNED
         (not floating 3.7.*) so the image digest is reproducible from this commit — a runtime image is a
         stable baseline and a float makes next month's rebuild a different digest. API surface used
         (AmazonS3Client, GetObjectAsync, ForcePathStyle, ServiceURL) is stable across 3.7. -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.511.8" />
  </ItemGroup>
</Project>
