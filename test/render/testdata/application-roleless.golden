# injected into the Deployment above; NATS streams are app-declared.
=== lan-exposed

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: lan-exposed
        namespace: team-b
        labels: { app.kubernetes.io/name: lan-exposed }
      spec:
        selector: { matchLabels: { app.kubernetes.io/name: lan-exposed } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: lan-exposed
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            # A lan-expose EIP is a kube-ovn distributed FIP, reachable from
            # the LAN only when the backing pod runs on the external-gateway
            # node — so pin exposed apps there. (No gateway node => Pending,
            # a clear signal the lan-expose feature isn't set up.)
            nodeSelector: { ovn.kubernetes.io/external-gw: "true" }
            containers:
              - name: app
                image: ghcr.io/me/mail:1
                # Each container port once per protocol ($containerPorts, deduped above);
                # the Service below keeps every Service port.
                ports:
                  - { containerPort: 2525 }
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 50m, memory: 64Mi }
                  limits: { cpu: 500m, memory: 512Mi }
---
# --- Service --- (only when the app exposes a port; a port-less worker has none).
#     The HTTP port (80 -> spec.port) plus any spec.additionalPorts — e.g. an SMTP 1025
#     or a second protocol an app serves beside its HTTP port. Multi-port Services need
#     named ports, so the HTTP port is named `http` (the Ingress references it by number).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: service
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      # Traefik runs on the host network: told to dial the Service's ClusterIP (nativelb) rather than a
      # pod IP, its connection reaches the pod from the kube-ovn join subnet, which the isolation policy admits.
      metadata: { name: lan-exposed, namespace: team-b, annotations: { traefik.ingress.kubernetes.io/service.nativelb: "true" } }
      spec:
        selector: { app.kubernetes.io/name: lan-exposed }
        ports:
          - { name: smtp, port: 25, targetPort: 2525 }
---
# --- LAN endpoint: the app's port on a stable LAN IP, for raw TCP /
#     non-HTTP / no-DNS access (alongside any Ingress). A ClusterIP Service
#     annotated openinfra.dev/lan-expose: the lan-expose controller gives it
#     a kube-ovn EIP that actually works from the LAN (plain MetalLB
#     LoadBalancer external access is broken under kube-ovn). The app pod is
#     pinned to the external-gateway node (below), which the EIP requires. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: app-lan
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      metadata:
        name: lan-exposed-lan
        namespace: team-b
        labels: { openinfra.dev/app-lan: lan-exposed }
        annotations: { openinfra.dev/lan-expose: "true" }
      spec:
        type: ClusterIP
        selector: { app.kubernetes.io/name: lan-exposed }
        ports: [ { port: 2525, targetPort: 2525 } ]
---
# --- HPA ("ASG") — only when there is room to scale (max > min). A fixed-size app
#     (min == max, e.g. {min: 1, max: 1}) gets NO HPA: an HPA with equal bounds has
#     nothing to do and just logs FailedGetResourceMetric/FailedComputeMetricsReplicas.
#     That fixed size is pinned as Deployment.replicas above (= $hpaMin). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: hpa
spec:
  forProvider:
    manifest:
      apiVersion: autoscaling/v2
      kind: HorizontalPodAutoscaler
      metadata: { name: lan-exposed, namespace: team-b }
      spec:
        scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: lan-exposed }
        minReplicas: 1
        maxReplicas: 5
        metrics:
          - type: Resource
            resource:
              name: cpu
              target: { type: Utilization, averageUtilization: 70 }
---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: lan-exposed-limits, namespace: team-b }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: lan-exposed-quota, namespace: team-b }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "100"
          persistentvolumeclaims: "60"
          services: "60"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: lan-exposed-allow, namespace: team-b }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: lan-exposed } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-b }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== sidecars-volumes

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: sidecars-volumes
        namespace: team-c
        labels: { app.kubernetes.io/name: sidecars-volumes }
      spec:
        selector: { matchLabels: { app.kubernetes.io/name: sidecars-volumes } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: sidecars-volumes
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: app
                image: ghcr.io/me/app:3
                # Each container port once per protocol ($containerPorts, deduped above);
                # the Service below keeps every Service port.
                ports:
                  - { containerPort: 3000 }
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 50m, memory: 64Mi }
                  limits: { cpu: 500m, memory: 512Mi }
                volumeMounts:
                  - { name: scratch, mountPath: /tmp/work }
                  - { name: data, mountPath: /var/lib/app }
                # Health checks auto-injected — k8s self-heals. The startup probe gives a slow
                # first boot (DB init, AV signature download) time to begin listening before
                # liveness can kill it: failureThreshold*10s ≈ startupGraceSeconds (default 150).
                # A port-less workload (a queue worker) renders NO probe — nothing listens, and
                # k8s still restarts it if the process exits.
                startupProbe:   { tcpSocket: { port: 3000 }, periodSeconds: 10, failureThreshold: 15 }
                readinessProbe: { tcpSocket: { port: 3000 } }
                livenessProbe:  { tcpSocket: { port: 3000 } }
                envFrom:
                  - secretRef: { name: sidecars-volumes-minio, optional: true }
              - name: log-shipper
                image: fluent/fluent-bit:3
                # $s.cpu/memory (an ECS sidecar container's Cpu/Memory) override the defaults.
                resources:
                  requests: { cpu: 25m, memory: 32Mi }
                  limits: { cpu: 500m, memory: 512Mi }
                env:
                  - { name: LEVEL, value: "info" }
                volumeMounts:
                  - { name: scratch, mountPath: /logs }
                envFrom:
                  - secretRef: { name: shipper-token, optional: true }
              - name: proxy
                image: envoyproxy/envoy:v1.30
                command: ["envoy"]
                args: ["-c","/etc/envoy.yaml"]
                ports: [ { containerPort: 9901 } ]
                # $s.cpu/memory (an ECS sidecar container's Cpu/Memory) override the defaults.
                resources:
                  requests: { cpu: 100m, memory: 128Mi }
                  limits: { cpu: 100m, memory: 128Mi }
            volumes:
              - { name: scratch, emptyDir: {} }
              - { name: data, persistentVolumeClaim: { claimName: app-data } }
---
# --- Service --- (only when the app exposes a port; a port-less worker has none).
#     The HTTP port (80 -> spec.port) plus any spec.additionalPorts — e.g. an SMTP 1025
#     or a second protocol an app serves beside its HTTP port. Multi-port Services need
#     named ports, so the HTTP port is named `http` (the Ingress references it by number).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: service
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      # Traefik runs on the host network: told to dial the Service's ClusterIP (nativelb) rather than a
      # pod IP, its connection reaches the pod from the kube-ovn join subnet, which the isolation policy admits.
      metadata: { name: sidecars-volumes, namespace: team-c, annotations: { traefik.ingress.kubernetes.io/service.nativelb: "true" } }
      spec:
        selector: { app.kubernetes.io/name: sidecars-volumes }
        ports:
          - { name: http, port: 80, targetPort: 3000 }
---
# --- HPA ("ASG") — only when there is room to scale (max > min). A fixed-size app
#     (min == max, e.g. {min: 1, max: 1}) gets NO HPA: an HPA with equal bounds has
#     nothing to do and just logs FailedGetResourceMetric/FailedComputeMetricsReplicas.
#     That fixed size is pinned as Deployment.replicas above (= $hpaMin). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: hpa
spec:
  forProvider:
    manifest:
      apiVersion: autoscaling/v2
      kind: HorizontalPodAutoscaler
      metadata: { name: sidecars-volumes, namespace: team-c }
      spec:
        scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: sidecars-volumes }
        minReplicas: 1
        maxReplicas: 5
        metrics:
          - type: Resource
            resource:
              name: cpu
              target: { type: Utilization, averageUtilization: 70 }
---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: sidecars-volumes-limits, namespace: team-c }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: sidecars-volumes-quota, namespace: team-c }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "100"
          persistentvolumeclaims: "60"
          services: "60"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: sidecars-volumes-allow, namespace: team-c }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: sidecars-volumes } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-c }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
---
# --- Object storage ("S3"): one Job (mc + kubectl in alpine/k8s) creates the
#     bucket(s), mints a PER-APP, NON-ROOT MinIO user scoped to ONLY those
#     buckets, and writes that user's creds to <name>-minio in the app
#     namespace (#151 fault 3 — an app never gets the MinIO root key, so it
#     can't reach another tenant's buckets). Runs in the minio namespace so
#     root comes from the minio secret via env — never this Composition — and
#     uses the pre-defined openinfra-bucket-setup SA. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: bucket-setup
spec:
  forProvider:
    manifest:
      apiVersion: batch/v1
      kind: Job
      metadata: { name: sidecars-volumes-bucket-0ad92, namespace: minio }
      spec:
        backoffLimit: 20
        # No ttlSecondsAfterFinished: provider-kubernetes recreates a TTL-GC'd managed Job
        # → infinite re-run loop; the finished Job persists as its done-marker (see bucket-composition.yaml).
        template:
          spec:
            serviceAccountName: openinfra-bucket-setup
            restartPolicy: OnFailure
            volumes:
              - { name: mc, emptyDir: {} }
              - { name: ownership, configMap: { name: openinfra-bucket-ownership } }
            initContainers:
              # Bring `mc` in OFFLINE (copied from its image) — used for bucket creation
              # AND minting the scoped per-app user/policy.
              - name: fetch-mc
                image: ghcr.io/harn3ss/open-infra-mc@sha256:a689825d5299d02e6f35973e726a6e49a77469cde644dd52d60586b07bd85744
                command: [sh, -c, "cp /usr/bin/mc /mc/mc && chmod +x /mc/mc"]
                volumeMounts: [{ name: mc, mountPath: /mc }]
            containers:
              - name: setup
                image: alpine/k8s:1.30.0
                volumeMounts: [{ name: mc, mountPath: /mc }, { name: ownership, mountPath: /opt/openinfra, readOnly: true }]
                env:
                  # Root is used ONLY to provision (create buckets + mint the scoped user);
                  # it is never written into the app's secret (#151 fault 3).
                  - name: ROOT_USER
                    valueFrom: { secretKeyRef: { name: minio, key: rootUser } }
                  - name: ROOT_PASS
                    valueFrom: { secretKeyRef: { name: minio, key: rootPassword } }
                  - { name: OWNER_NS, value: "team-c" }
                  - { name: OWNER_REF, value: "Application/team-c/sidecars-volumes" }
                  - { name: XR_CREATED, value: "2026-11-01T10:00:00Z" }
                command: ["/bin/sh", "-c"]
                args:
                  - |
                    set -e
                    MC=/mc/mc
                    E=http://minio.minio.svc.cluster.local:9000
                    # alias set validates the root creds — a rotated/wrong root key fails HERE,
                    # loud, instead of handing out a credential that won't work (#151 faults 1+2).
                    "$MC" alias set m "$E" "$ROOT_USER" "$ROOT_PASS" >/dev/null
                    # 0. Every bucket must be this namespace's (or new) before anything is created or granted.
                    . /opt/openinfra/bucket-ownership.sh
                    for b in app-uploads app-exports ; do
                      claim_bucket "$b"
                    done
                    # 1. Create each declared bucket idempotently but FAIL LOUD (#151 fault 1):
                    #    --ignore-existing is fine; any other error (server down, quota) exits.
                    for b in app-uploads app-exports ; do
                      "$MC" mb --ignore-existing "m/$b"
                      echo "bucket $b ready"
                    done
                    # 2. Mint a PER-APP, NON-ROOT user scoped to ONLY these buckets (#151 fault 3). Its key
                    #    lives in a platform-side Secret (openinfra-bucket-creds/<user>); a provider Object
                    #    copies it into sidecars-volumes-minio and GCs it with the claim.
                    APPUSER="app-team-c-sidecars-volumes-48215f33cc"
                    # Allow ONLY this app's buckets; everything else default-denies, so a compromised
                    # app can't reach — let alone delete — another tenant's buckets.
                    RES=""
                    for b in app-uploads app-exports ; do
                      RES="$RES\"arn:aws:s3:::$b\",\"arn:aws:s3:::$b/*\","
                    done
                    printf '{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":["s3:*"],"Resource":[%s]}]}' "${RES%,}" > /tmp/pol.json
                    mint_scoped_user "$APPUSER" /tmp/pol.json
---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: app-pcreds
    # Observing the platform-side creds must not hold the claim NotReady: a claim from before the
    # scoped-creds model has none until its migration seeds one (its old Secret keeps it working).
    gotemplating.fn.crossplane.io/ready: "True"
spec:
  managementPolicies: ["Observe"]
  forProvider:
    manifest:
      apiVersion: v1
      kind: Secret
      metadata: { name: app-team-c-sidecars-volumes-48215f33cc, namespace: openinfra-bucket-creds }
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== db-postgres-full

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: db-postgres-full
        namespace: team-a
        labels: { app.kubernetes.io/name: db-postgres-full }
      spec:
        selector: { matchLabels: { app.kubernetes.io/name: db-postgres-full } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: db-postgres-full
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: app
                image: ghcr.io/me/api:2
                # Each container port once per protocol ($containerPorts, deduped above);
                # the Service below keeps every Service port.
                ports:
                  - { containerPort: 8080 }
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 50m, memory: 64Mi }
                  limits: { cpu: 500m, memory: 512Mi }
                # Health checks auto-injected — k8s self-heals. The startup probe gives a slow
                # first boot (DB init, AV signature download) time to begin listening before
                # liveness can kill it: failureThreshold*10s ≈ startupGraceSeconds (default 150).
                # A port-less workload (a queue worker) renders NO probe — nothing listens, and
                # k8s still restarts it if the process exits.
                startupProbe:   { tcpSocket: { port: 8080 }, periodSeconds: 10, failureThreshold: 15 }
                readinessProbe: { tcpSocket: { port: 8080 } }
                livenessProbe:  { tcpSocket: { port: 8080 } }
                env:
                  # Injected Postgres connection (CloudNativePG app secret).
                  - name: DATABASE_URL
                    valueFrom:
                      secretKeyRef: { name: db-postgres-full-db-app, key: uri }
                  # Reader endpoint (the Aurora reader-endpoint analog): CNPG's -ro Service
                  # load-balances reads across the replicas. Combine with the DATABASE_URL
                  # credentials. Opt-in (database.readerEndpoint) + needs standbys (HA or replicas>1).
                  - name: DATABASE_RO_HOST
                    value: "db-postgres-full-db-ro.team-a.svc.cluster.local"
---
# --- Service --- (only when the app exposes a port; a port-less worker has none).
#     The HTTP port (80 -> spec.port) plus any spec.additionalPorts — e.g. an SMTP 1025
#     or a second protocol an app serves beside its HTTP port. Multi-port Services need
#     named ports, so the HTTP port is named `http` (the Ingress references it by number).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: service
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      # Traefik runs on the host network: told to dial the Service's ClusterIP (nativelb) rather than a
      # pod IP, its connection reaches the pod from the kube-ovn join subnet, which the isolation policy admits.
      metadata: { name: db-postgres-full, namespace: team-a, annotations: { traefik.ingress.kubernetes.io/service.nativelb: "true" } }
      spec:
        selector: { app.kubernetes.io/name: db-postgres-full }
        ports:
          - { name: http, port: 80, targetPort: 8080 }
---
# --- HPA ("ASG") — only when there is room to scale (max > min). A fixed-size app
#     (min == max, e.g. {min: 1, max: 1}) gets NO HPA: an HPA with equal bounds has
#     nothing to do and just logs FailedGetResourceMetric/FailedComputeMetricsReplicas.
#     That fixed size is pinned as Deployment.replicas above (= $hpaMin). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: hpa
spec:
  forProvider:
    manifest:
      apiVersion: autoscaling/v2
      kind: HorizontalPodAutoscaler
      metadata: { name: db-postgres-full, namespace: team-a }
      spec:
        scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: db-postgres-full }
        minReplicas: 1
        maxReplicas: 5
        metrics:
          - type: Resource
            resource:
              name: cpu
              target: { type: Utilization, averageUtilization: 70 }
---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: db-postgres-full-limits, namespace: team-a }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: db-postgres-full-quota, namespace: team-a }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "100"
          persistentvolumeclaims: "60"
          services: "60"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: db-postgres-full-allow, namespace: team-a }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: db-postgres-full } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-a }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
---
# --- Tenant isolation (ingress) for the database tier: the app's netpol above selects only the
#     app's pods, and each engine labels its pods its own way, so the DB gets its own policy.
#     This namespace (the app, its jobs and snapshots), host-sourced traffic (NodePort /
#     LoadBalancer through kube-proxy; LAN publishing adds its own allow), the console and
#     Prometheus, and the engine's operator. Every other namespace is refused. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: db-netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata:
        name: db-postgres-full-db-isolation
        namespace: team-a
        labels: { openinfra.dev/isolation: tenant }
      spec:
        podSelector: { matchLabels: { cnpg.io/cluster: "db-postgres-full-db" } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # this namespace
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: team-a } }
              # host-sourced traffic (NodePort, LoadBalancer and external-IP Services through
              # kube-proxy) arrives as a node's kube-ovn join IP
              - ipBlock: { cidr: 100.64.0.0/16 }
              # the console (database stats, Peek, point-in-time restore)
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: open-infra-console } }
                podSelector: { matchLabels: { app: console } }
              # Prometheus, scraping metrics
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: monitoring } }
                podSelector: { matchLabels: { app.kubernetes.io/name: prometheus } }
              # the CloudNativePG operator (instance status, backups, failover)
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: cnpg-system } }
---
# --- Managed Postgres ("RDS") via CloudNativePG. LOCAL NVMe only. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: database
spec:
  forProvider:
    manifest:
      apiVersion: postgresql.cnpg.io/v1
      kind: Cluster
      metadata:
        name: db-postgres-full-db
        namespace: team-a
        # Declarative hibernation: on -> CNPG scales instances to zero (PVCs kept);
        # off -> resume. ALWAYS set it (not just when stopped) — omitting the
        # annotation does NOT reliably clear an existing "on", so Start (stopped=false)
        # must explicitly write "off" to un-hibernate.
        annotations: { cnpg.io/hibernation: "off" }
      spec:
        # DB tier is deliberately NOT an SG member: a SecurityGroup fences the app's
        # user-facing ingress (its port); inheriting it onto the CNPG pods applied that
        # port-scoped rule to the DB and blackholed the DB's own ports — the operator's
        # status port (cluster wedged at 1/2), streaming replication (no HA), and even
        # the app's own 5432 connection. The app reaches the DB via its injected
        # connection secret (password); the DB stays on CNPG's default network posture.
        # database.highAvailability -> primary + hot standby, streaming
        # replication, automatic failover. local-path PVs are node-local,
        # so anti-affinity (one instance per node) is what makes the DB
        # survive a node loss — the standby is promoted automatically.
        instances: 2
        # database.pointInTimeRecovery: archive WAL continuously to the ObjectStore below
        # (barman-cloud CNPG-I plugin, cluster-installed). This is the WAL stream a
        # point-in-time restore replays. Restore = bootstrap a new cluster to a target time.
        plugins:
          - name: barman-cloud.cloudnative-pg.io
            isWALArchiver: true
            parameters:
              barmanObjectName: db-postgres-full-db-backup
        # Propagate the encryption-key annotation onto every PVC CNPG creates, so the
        # volume-crypto reconciler materializes each <pvc>-crypto LUKS secret from the
        # customer EncryptionKey (destroy the key -> the DB's storage is crypto-erased).
        inheritedMetadata:
          annotations:
            openinfra.dev/encryption-key: "orders-key"
        # Fail-closed storage placement (#307): instances must land on a node whose local-path
        # disk measured nvme or sata-ssd (openinfra.dev/disk-class, set by the disk-class-labeler
        # DaemonSet). An unlabeled / hdd / unknown node is INELIGIBLE — unknown never passes as fast.
        affinity:
          nodeAffinity:
            requiredDuringSchedulingIgnoredDuringExecution:
              nodeSelectorTerms:
                - matchExpressions:
                    - { key: openinfra.dev/disk-class, operator: In, values: [nvme, sata-ssd] }
          enablePodAntiAffinity: true
          topologyKey: kubernetes.io/hostname
          podAntiAffinityType: required
        # pg_stat_statements: query history powering the database "Peek"
        # (issue #56 — top running queries). Must be preloaded at server start;
        # the extension itself is created in the app database below.
        postgresql:
          shared_preload_libraries:
            - pg_stat_statements
        # Capacity from RDS DBInstanceClass (#114): CPU/memory requested as dedicated
        # resources (request == limit). Burst-credit accounting is not modelled.
        resources:
          requests:
            cpu: "1"
            memory: "2Gi"
          limits:
            cpu: "1"
            memory: "2Gi"
        storage:
          size: 20Gi
          storageClass: longhorn-encrypted   # NEVER CIFS/NFS
        bootstrap:
          initdb:
            database: orders
            owner: app
            postInitApplicationSQL:
              - CREATE EXTENSION IF NOT EXISTS pg_stat_statements
              # let the app user read ALL query text in Peek (else other roles'
              # queries show as "<insufficient privilege>"). Safe: it's our own DB.
              - GRANT pg_read_all_stats TO app
              # pgvector: vector similarity search (RAG with Models).
              - CREATE EXTENSION IF NOT EXISTS vector
---
# database.pointInTimeRecovery: the object store the barman-cloud WAL archiver writes to.
# MinIO, per-DB path under the platform backup bucket; retentionPolicy = backtrackWindow.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: db-backup-store
spec:
  forProvider:
    manifest:
      apiVersion: barmancloud.cnpg.io/v1
      kind: ObjectStore
      metadata:
        name: db-postgres-full-db-backup
        namespace: team-a
      spec:
        retentionPolicy: "3d"
        configuration:
          destinationPath: s3://db-snapshots/wal/team-a/db-postgres-full/
          endpointURL: http://minio.minio.svc.cluster.local:9000
          s3Credentials:
            accessKeyId: { name: db-postgres-full-db-backup-creds, key: ak }
            secretAccessKey: { name: db-postgres-full-db-backup-creds, key: sk }
          wal: { compression: gzip }
          data: { compression: gzip }
---
# Mint a per-DB, NON-ROOT MinIO user scoped to ONLY this DB's WAL path, into
# <name>-db-backup-creds (the ObjectStore above reads it). Same pattern + SA as bucket-setup:
# root provisions only, is never written into the app namespace.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: db-backup-setup
spec:
  forProvider:
    manifest:
      apiVersion: batch/v1
      kind: Job
      metadata: { name: db-postgres-full-db-backup-setup-v2, namespace: minio }
      spec:
        backoffLimit: 20
        # No ttlSecondsAfterFinished: provider-kubernetes recreates a TTL-GC'd managed Job
        # → infinite re-run loop; the finished Job persists as its done-marker (see bucket-composition.yaml).
        template:
          spec:
            serviceAccountName: openinfra-bucket-setup
            restartPolicy: OnFailure
            volumes:
              - { name: mc, emptyDir: {} }
              - { name: ownership, configMap: { name: openinfra-bucket-ownership } }
            initContainers:
              - name: fetch-mc
                image: ghcr.io/harn3ss/open-infra-mc@sha256:a689825d5299d02e6f35973e726a6e49a77469cde644dd52d60586b07bd85744
                securityContext:
                  runAsNonRoot: true
                  runAsUser: 65532
                  allowPrivilegeEscalation: false
                  capabilities: { drop: [ALL] }
                command: [sh, -c, "cp /usr/bin/mc /mc/mc && chmod +x /mc/mc"]
                volumeMounts: [{ name: mc, mountPath: /mc }]
            containers:
              - name: setup
                image: alpine/k8s:1.30.0
                volumeMounts: [{ name: mc, mountPath: /mc }, { name: ownership, mountPath: /opt/openinfra, readOnly: true }]
                env:
                  - name: ROOT_USER
                    valueFrom: { secretKeyRef: { name: minio, key: rootUser } }
                  - name: ROOT_PASS
                    valueFrom: { secretKeyRef: { name: minio, key: rootPassword } }
                command: ["/bin/sh", "-c"]
                args:
                  - |
                    set -e
                    MC=/mc/mc
                    E=http://minio.minio.svc.cluster.local:9000
                    # Source the shared helpers (mint_scoped_user + OWN_NS); this Job does not call
                    # claim_bucket (db-snapshots is a platform bucket) but reuses mint_scoped_user.
                    . /opt/openinfra/bucket-ownership.sh
                    "$MC" alias set m "$E" "$ROOT_USER" "$ROOT_PASS" >/dev/null
                    # Platform backup bucket (shared with snapshots); per-DB path keeps tenants apart.
                    "$MC" mb --ignore-existing m/db-snapshots
                    BKPUSER="bkp-team-a-db-postgres-full"
                    # Scope to ONLY this DB's WAL path (+ the bucket list/location barman needs).
                    P=wal/team-a/db-postgres-full
                    printf '{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":["s3:GetObject","s3:PutObject","s3:DeleteObject","s3:ListMultipartUploadParts","s3:AbortMultipartUpload"],"Resource":["arn:aws:s3:::db-snapshots/'"$P"'/*"]},{"Effect":"Allow","Action":["s3:ListBucket","s3:GetBucketLocation"],"Resource":["arn:aws:s3:::db-snapshots"]}]}' > /tmp/pol.json
                    # The key lives in a platform-side Secret; a provider Object copies it into
                    # db-postgres-full-db-backup-creds (keys ak/sk) and GCs it with the claim.
                    mint_scoped_user "$BKPUSER" /tmp/pol.json
---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: db-backup-pcreds
    # Observing the platform-side creds must not hold the claim NotReady: a claim from before the
    # scoped-creds model has none until its migration seeds one (its old Secret keeps it working).
    gotemplating.fn.crossplane.io/ready: "True"
spec:
  managementPolicies: ["Observe"]
  forProvider:
    manifest:
      apiVersion: v1
      kind: Secret
      metadata: { name: bkp-team-a-db-postgres-full, namespace: openinfra-bucket-creds }
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== db-postgres-replicas-autoscaling

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: db-postgres-replicas-autoscaling
        namespace: team-a
        labels: { app.kubernetes.io/name: db-postgres-replicas-autoscaling }
      spec:
        selector: { matchLabels: { app.kubernetes.io/name: db-postgres-replicas-autoscaling } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: db-postgres-replicas-autoscaling
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: app
                image: ghcr.io/me/api:2
                # Each container port once per protocol ($containerPorts, deduped above);
                # the Service below keeps every Service port.
                ports:
                  - { containerPort: 8080 }
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 50m, memory: 64Mi }
                  limits: { cpu: 500m, memory: 512Mi }
                # Health checks auto-injected — k8s self-heals. The startup probe gives a slow
                # first boot (DB init, AV signature download) time to begin listening before
                # liveness can kill it: failureThreshold*10s ≈ startupGraceSeconds (default 150).
                # A port-less workload (a queue worker) renders NO probe — nothing listens, and
                # k8s still restarts it if the process exits.
                startupProbe:   { tcpSocket: { port: 8080 }, periodSeconds: 10, failureThreshold: 15 }
                readinessProbe: { tcpSocket: { port: 8080 } }
                livenessProbe:  { tcpSocket: { port: 8080 } }
                env:
                  # Injected Postgres connection (CloudNativePG app secret).
                  - name: DATABASE_URL
                    valueFrom:
                      secretKeyRef: { name: db-postgres-replicas-autoscaling-db-app, key: uri }
                  # Reader endpoint (the Aurora reader-endpoint analog): CNPG's -ro Service
                  # load-balances reads across the replicas. Combine with the DATABASE_URL
                  # credentials. Opt-in (database.readerEndpoint) + needs standbys (HA or replicas>1).
                  - name: DATABASE_RO_HOST
                    value: "db-postgres-replicas-autoscaling-db-ro.team-a.svc.cluster.local"
---
# --- Service --- (only when the app exposes a port; a port-less worker has none).
#     The HTTP port (80 -> spec.port) plus any spec.additionalPorts — e.g. an SMTP 1025
#     or a second protocol an app serves beside its HTTP port. Multi-port Services need
#     named ports, so the HTTP port is named `http` (the Ingress references it by number).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: service
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      # Traefik runs on the host network: told to dial the Service's ClusterIP (nativelb) rather than a
      # pod IP, its connection reaches the pod from the kube-ovn join subnet, which the isolation policy admits.
      metadata: { name: db-postgres-replicas-autoscaling, namespace: team-a, annotations: { traefik.ingress.kubernetes.io/service.nativelb: "true" } }
      spec:
        selector: { app.kubernetes.io/name: db-postgres-replicas-autoscaling }
        ports:
          - { name: http, port: 80, targetPort: 8080 }
---
# --- HPA ("ASG") — only when there is room to scale (max > min). A fixed-size app
#     (min == max, e.g. {min: 1, max: 1}) gets NO HPA: an HPA with equal bounds has
#     nothing to do and just logs FailedGetResourceMetric/FailedComputeMetricsReplicas.
#     That fixed size is pinned as Deployment.replicas above (= $hpaMin). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: hpa
spec:
  forProvider:
    manifest:
      apiVersion: autoscaling/v2
      kind: HorizontalPodAutoscaler
      metadata: { name: db-postgres-replicas-autoscaling, namespace: team-a }
      spec:
        scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: db-postgres-replicas-autoscaling }
        minReplicas: 1
        maxReplicas: 5
        metrics:
          - type: Resource
            resource:
              name: cpu
              target: { type: Utilization, averageUtilization: 70 }
---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: db-postgres-replicas-autoscaling-limits, namespace: team-a }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: db-postgres-replicas-autoscaling-quota, namespace: team-a }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "100"
          persistentvolumeclaims: "60"
          services: "60"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: db-postgres-replicas-autoscaling-allow, namespace: team-a }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: db-postgres-replicas-autoscaling } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-a }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
---
# --- Tenant isolation (ingress) for the database tier: the app's netpol above selects only the
#     app's pods, and each engine labels its pods its own way, so the DB gets its own policy.
#     This namespace (the app, its jobs and snapshots), host-sourced traffic (NodePort /
#     LoadBalancer through kube-proxy; LAN publishing adds its own allow), the console and
#     Prometheus, and the engine's operator. Every other namespace is refused. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: db-netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata:
        name: db-postgres-replicas-autoscaling-db-isolation
        namespace: team-a
        labels: { openinfra.dev/isolation: tenant }
      spec:
        podSelector: { matchLabels: { cnpg.io/cluster: "db-postgres-replicas-autoscaling-db" } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # this namespace
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: team-a } }
              # host-sourced traffic (NodePort, LoadBalancer and external-IP Services through
              # kube-proxy) arrives as a node's kube-ovn join IP
              - ipBlock: { cidr: 100.64.0.0/16 }
              # the console (database stats, Peek, point-in-time restore)
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: open-infra-console } }
                podSelector: { matchLabels: { app: console } }
              # Prometheus, scraping metrics
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: monitoring } }
                podSelector: { matchLabels: { app.kubernetes.io/name: prometheus } }
              # the CloudNativePG operator (instance status, backups, failover)
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: cnpg-system } }
---
# --- Managed Postgres ("RDS") via CloudNativePG. LOCAL NVMe only. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: database
spec:
  forProvider:
    manifest:
      apiVersion: postgresql.cnpg.io/v1
      kind: Cluster
      metadata:
        name: db-postgres-replicas-autoscaling-db
        namespace: team-a
        # Declarative hibernation: on -> CNPG scales instances to zero (PVCs kept);
        # off -> resume. ALWAYS set it (not just when stopped) — omitting the
        # annotation does NOT reliably clear an existing "on", so Start (stopped=false)
        # must explicitly write "off" to un-hibernate.
        annotations: { cnpg.io/hibernation: "off" }
      spec:
        # DB tier is deliberately NOT an SG member: a SecurityGroup fences the app's
        # user-facing ingress (its port); inheriting it onto the CNPG pods applied that
        # port-scoped rule to the DB and blackholed the DB's own ports — the operator's
        # status port (cluster wedged at 1/2), streaming replication (no HA), and even
        # the app's own 5432 connection. The app reaches the DB via its injected
        # connection secret (password); the DB stays on CNPG's default network posture.
        # database.highAvailability -> primary + hot standby, streaming
        # replication, automatic failover. local-path PVs are node-local,
        # so anti-affinity (one instance per node) is what makes the DB
        # survive a node loss — the standby is promoted automatically.
        # database.autoscaling: instances is OWNED by the KEDA ScaledObject below (via the
        # Cluster /scale subresource) — omitted here so Crossplane doesn't fight the autoscaler.
        # Fail-closed storage placement (#307): instances must land on a node whose local-path
        # disk measured nvme or sata-ssd (openinfra.dev/disk-class, set by the disk-class-labeler
        # DaemonSet). An unlabeled / hdd / unknown node is INELIGIBLE — unknown never passes as fast.
        affinity:
          nodeAffinity:
            requiredDuringSchedulingIgnoredDuringExecution:
              nodeSelectorTerms:
                - matchExpressions:
                    - { key: openinfra.dev/disk-class, operator: In, values: [nvme, sata-ssd] }
          enablePodAntiAffinity: true
          topologyKey: kubernetes.io/hostname
          podAntiAffinityType: required
        # pg_stat_statements: query history powering the database "Peek"
        # (issue #56 — top running queries). Must be preloaded at server start;
        # the extension itself is created in the app database below.
        postgresql:
          shared_preload_libraries:
            - pg_stat_statements
        storage:
          size: 5Gi
          storageClass: local-path   # NEVER CIFS/NFS
        bootstrap:
          initdb:
            database: db-postgres-replicas-autoscaling
            owner: app
            postInitApplicationSQL:
              - CREATE EXTENSION IF NOT EXISTS pg_stat_statements
              # let the app user read ALL query text in Peek (else other roles'
              # queries show as "<insufficient privilege>"). Safe: it's our own DB.
              - GRANT pg_read_all_stats TO app
---
# database.autoscaling (the Aurora replica-autoscaling analog): KEDA target-tracks CPU
# utilization and scales the CNPG Cluster's instance count between min and max via the
# Cluster /scale subresource (.spec.instances). The composition omits instances above so
# the autoscaler owns it. More instances automatically widen the -ro reader pool.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: db-autoscaler
spec:
  forProvider:
    manifest:
      apiVersion: keda.sh/v1alpha1
      kind: ScaledObject
      metadata:
        name: db-postgres-replicas-autoscaling-db
        namespace: team-a
        annotations:
          argocd.argoproj.io/sync-options: SkipDryRunOnMissingResource=true
      spec:
        scaleTargetRef:
          apiVersion: postgresql.cnpg.io/v1
          kind: Cluster
          name: db-postgres-replicas-autoscaling-db
        minReplicaCount: 2
        maxReplicaCount: 5
        triggers:
          - type: cpu
            metricType: Utilization
            metadata:
              value: "65"
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== db-postgres-expose

---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: db-postgres-expose-limits, namespace: team-a }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: db-postgres-expose-quota, namespace: team-a }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "100"
          persistentvolumeclaims: "60"
          services: "60"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: db-postgres-expose-allow, namespace: team-a }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: db-postgres-expose } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-a }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
---
# --- Tenant isolation (ingress) for the database tier: the app's netpol above selects only the
#     app's pods, and each engine labels its pods its own way, so the DB gets its own policy.
#     This namespace (the app, its jobs and snapshots), host-sourced traffic (NodePort /
#     LoadBalancer through kube-proxy; LAN publishing adds its own allow), the console and
#     Prometheus, and the engine's operator. Every other namespace is refused. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: db-netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata:
        name: db-postgres-expose-db-isolation
        namespace: team-a
        labels: { openinfra.dev/isolation: tenant }
      spec:
        podSelector: { matchLabels: { cnpg.io/cluster: "db-postgres-expose-db" } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # this namespace
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: team-a } }
              # host-sourced traffic (NodePort, LoadBalancer and external-IP Services through
              # kube-proxy) arrives as a node's kube-ovn join IP
              - ipBlock: { cidr: 100.64.0.0/16 }
              # the console (database stats, Peek, point-in-time restore)
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: open-infra-console } }
                podSelector: { matchLabels: { app: console } }
              # Prometheus, scraping metrics
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: monitoring } }
                podSelector: { matchLabels: { app.kubernetes.io/name: prometheus } }
              # the CloudNativePG operator (instance status, backups, failover)
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: cnpg-system } }
---
# --- Managed Postgres ("RDS") via CloudNativePG. LOCAL NVMe only. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: database
spec:
  forProvider:
    manifest:
      apiVersion: postgresql.cnpg.io/v1
      kind: Cluster
      metadata:
        name: db-postgres-expose-db
        namespace: team-a
        # Declarative hibernation: on -> CNPG scales instances to zero (PVCs kept);
        # off -> resume. ALWAYS set it (not just when stopped) — omitting the
        # annotation does NOT reliably clear an existing "on", so Start (stopped=false)
        # must explicitly write "off" to un-hibernate.
        annotations: { cnpg.io/hibernation: "off" }
      spec:
        # DB tier is deliberately NOT an SG member: a SecurityGroup fences the app's
        # user-facing ingress (its port); inheriting it onto the CNPG pods applied that
        # port-scoped rule to the DB and blackholed the DB's own ports — the operator's
        # status port (cluster wedged at 1/2), streaming replication (no HA), and even
        # the app's own 5432 connection. The app reaches the DB via its injected
        # connection secret (password); the DB stays on CNPG's default network posture.
        # database.highAvailability -> primary + hot standby, streaming
        # replication, automatic failover. local-path PVs are node-local,
        # so anti-affinity (one instance per node) is what makes the DB
        # survive a node loss — the standby is promoted automatically.
        instances: 1
        # Fail-closed storage placement (#307): instances must land on a node whose local-path
        # disk measured nvme or sata-ssd (openinfra.dev/disk-class, set by the disk-class-labeler
        # DaemonSet). An unlabeled / hdd / unknown node is INELIGIBLE — unknown never passes as fast.
        affinity:
          nodeAffinity:
            requiredDuringSchedulingIgnoredDuringExecution:
              nodeSelectorTerms:
                - matchExpressions:
                    - { key: openinfra.dev/disk-class, operator: In, values: [nvme, sata-ssd] }
          # A DB LAN endpoint (lan-expose EIP = distributed FIP) requires the
          # DB pod on the external-gateway node.
          nodeSelector: { ovn.kubernetes.io/external-gw: "true" }
        # pg_stat_statements: query history powering the database "Peek"
        # (issue #56 — top running queries). Must be preloaded at server start;
        # the extension itself is created in the app database below.
        postgresql:
          shared_preload_libraries:
            - pg_stat_statements
        storage:
          size: 5Gi
          storageClass: local-path   # NEVER CIFS/NFS
        bootstrap:
          initdb:
            database: db-postgres-expose
            owner: app
            postInitApplicationSQL:
              - CREATE EXTENSION IF NOT EXISTS pg_stat_statements
              # let the app user read ALL query text in Peek (else other roles'
              # queries show as "<insufficient privilege>"). Safe: it's our own DB.
              - GRANT pg_read_all_stats TO app
---
# --- LAN endpoint: a MetalLB LoadBalancer so workstations on the LAN
#     can reach the database directly (psql/GUI/migrations). Consumes
#     one pool IP — opt-in via database.expose. Targets the writable
#     primary for postgres. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: db-lan
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      metadata:
        name: db-postgres-expose-db-lan
        namespace: team-a
        labels: { app.kubernetes.io/part-of: db-postgres-expose }
        annotations: { openinfra.dev/lan-expose: "true" }
      spec:
        type: ClusterIP
        selector: { cnpg.io/cluster: db-postgres-expose-db, cnpg.io/instanceRole: primary }
        ports: [ { port: 5432, targetPort: 5432 } ]
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== db-mongo

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: db-mongo
        namespace: team-b
        labels: { app.kubernetes.io/name: db-mongo }
      spec:
        selector: { matchLabels: { app.kubernetes.io/name: db-mongo } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: db-mongo
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: app
                image: ghcr.io/me/catalog:1
                # Each container port once per protocol ($containerPorts, deduped above);
                # the Service below keeps every Service port.
                ports:
                  - { containerPort: 8080 }
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 50m, memory: 64Mi }
                  limits: { cpu: 500m, memory: 512Mi }
                # Health checks auto-injected — k8s self-heals. The startup probe gives a slow
                # first boot (DB init, AV signature download) time to begin listening before
                # liveness can kill it: failureThreshold*10s ≈ startupGraceSeconds (default 150).
                # A port-less workload (a queue worker) renders NO probe — nothing listens, and
                # k8s still restarts it if the process exits.
                startupProbe:   { tcpSocket: { port: 8080 }, periodSeconds: 10, failureThreshold: 15 }
                readinessProbe: { tcpSocket: { port: 8080 } }
                livenessProbe:  { tcpSocket: { port: 8080 } }
                env:
                  # Injected MongoDB connection (FerretDB endpoint).
                  - name: MONGODB_URI
                    valueFrom:
                      secretKeyRef: { name: db-mongo-mongo-app, key: MONGODB_URI }
---
# --- Service --- (only when the app exposes a port; a port-less worker has none).
#     The HTTP port (80 -> spec.port) plus any spec.additionalPorts — e.g. an SMTP 1025
#     or a second protocol an app serves beside its HTTP port. Multi-port Services need
#     named ports, so the HTTP port is named `http` (the Ingress references it by number).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: service
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      # Traefik runs on the host network: told to dial the Service's ClusterIP (nativelb) rather than a
      # pod IP, its connection reaches the pod from the kube-ovn join subnet, which the isolation policy admits.
      metadata: { name: db-mongo, namespace: team-b, annotations: { traefik.ingress.kubernetes.io/service.nativelb: "true" } }
      spec:
        selector: { app.kubernetes.io/name: db-mongo }
        ports:
          - { name: http, port: 80, targetPort: 8080 }
---
# --- HPA ("ASG") — only when there is room to scale (max > min). A fixed-size app
#     (min == max, e.g. {min: 1, max: 1}) gets NO HPA: an HPA with equal bounds has
#     nothing to do and just logs FailedGetResourceMetric/FailedComputeMetricsReplicas.
#     That fixed size is pinned as Deployment.replicas above (= $hpaMin). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: hpa
spec:
  forProvider:
    manifest:
      apiVersion: autoscaling/v2
      kind: HorizontalPodAutoscaler
      metadata: { name: db-mongo, namespace: team-b }
      spec:
        scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: db-mongo }
        minReplicas: 1
        maxReplicas: 5
        metrics:
          - type: Resource
            resource:
              name: cpu
              target: { type: Utilization, averageUtilization: 70 }
---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: db-mongo-limits, namespace: team-b }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: db-mongo-quota, namespace: team-b }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "100"
          persistentvolumeclaims: "60"
          services: "60"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: db-mongo-allow, namespace: team-b }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: db-mongo } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-b }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
---
# --- Tenant isolation (ingress) for the database tier: the app's netpol above selects only the
#     app's pods, and each engine labels its pods its own way, so the DB gets its own policy.
#     This namespace (the app, its jobs and snapshots), host-sourced traffic (NodePort /
#     LoadBalancer through kube-proxy; LAN publishing adds its own allow), the console and
#     Prometheus, and the engine's operator. Every other namespace is refused. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: db-netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata:
        name: db-mongo-db-isolation
        namespace: team-b
        labels: { openinfra.dev/isolation: tenant }
      spec:
        podSelector: { matchExpressions: [ { key: app.kubernetes.io/name, operator: In, values: [ "db-mongo-docdb", "db-mongo-mongo" ] } ] }
        policyTypes: [Ingress]
        ingress:
          - from:
              # this namespace
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: team-b } }
              # host-sourced traffic (NodePort, LoadBalancer and external-IP Services through
              # kube-proxy) arrives as a node's kube-ovn join IP
              - ipBlock: { cidr: 100.64.0.0/16 }
              # the console (database stats, Peek, point-in-time restore)
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: open-infra-console } }
                podSelector: { matchLabels: { app: console } }
              # Prometheus, scraping metrics
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: monitoring } }
                podSelector: { matchLabels: { app.kubernetes.io/name: prometheus } }
---
# --- NoSQL ("DynamoDB"): FerretDB (Mongo wire protocol) on the
#     DocumentDB-Postgres extension — all Apache-2.0. The stateless
#     proxy tier scales out for HA; storage is a single Postgres for
#     now (storage-tier failover needs DocumentDB-in-CNPG, tracked). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: mongo-secret
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Secret
      metadata: { name: db-mongo-mongo-app, namespace: team-b }
      stringData:
        username: app
        password: "fb72f81c43210988ed2ef343"
        MONGODB_URI: "mongodb://app:fb72f81c43210988ed2ef343@db-mongo-mongo.team-b.svc.cluster.local:27017/db-mongo"
        POSTGRESQL_URL: "postgres://app:fb72f81c43210988ed2ef343@db-mongo-docdb.team-b.svc.cluster.local:5432/postgres"
---
# DocumentDB-Postgres data volume (local NVMe).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: docdb-pvc
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: PersistentVolumeClaim
      metadata: { name: db-mongo-docdb-data, namespace: team-b }
      spec:
        accessModes: [ReadWriteOnce]
        storageClassName: local-path
        resources: { requests: { storage: 5Gi } }
---
# DocumentDB-Postgres: the storage engine FerretDB translates into.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: docdb
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: db-mongo-docdb
        namespace: team-b
        labels: { app.kubernetes.io/name: db-mongo-docdb }
      spec:
        replicas: 1
        strategy: { type: Recreate }
        selector: { matchLabels: { app.kubernetes.io/name: db-mongo-docdb } }
        template:
          metadata: { labels: { app.kubernetes.io/name: db-mongo-docdb } }
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            # Fail-closed storage placement (#307): disk-class must be nvme or sata-ssd
            # (this is the DocumentDB tier that holds the data, on local-path).
            affinity:
              nodeAffinity:
                requiredDuringSchedulingIgnoredDuringExecution:
                  nodeSelectorTerms:
                    - matchExpressions:
                        - { key: openinfra.dev/disk-class, operator: In, values: [nvme, sata-ssd] }
            containers:
              - name: postgres
                image: ghcr.io/ferretdb/postgres-documentdb:17
                env:
                  - { name: POSTGRES_USER, value: app }
                  - { name: POSTGRES_DB, value: postgres }
                  - name: POSTGRES_PASSWORD
                    valueFrom: { secretKeyRef: { name: db-mongo-mongo-app, key: password } }
                ports: [ { containerPort: 5432 } ]
                resources:
                  requests: { cpu: 100m, memory: 256Mi }
                  limits: { cpu: "2", memory: 2Gi }
                volumeMounts: [ { name: data, mountPath: /var/lib/postgresql/data } ]
                readinessProbe: { exec: { command: ["pg_isready", "-U", "app"] }, initialDelaySeconds: 10, periodSeconds: 10 }
            volumes:
              - name: data
                persistentVolumeClaim: { claimName: db-mongo-docdb-data }
---
# DocumentDB-Postgres Service.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: docdb-svc
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      metadata: { name: db-mongo-docdb, namespace: team-b }
      spec:
        selector: { app.kubernetes.io/name: db-mongo-docdb }
        ports: [ { port: 5432, targetPort: 5432 } ]
---
# FerretDB proxy (stateless -> scales for HA). Speaks the Mongo protocol.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: mongo
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: db-mongo-mongo
        namespace: team-b
        labels: { app.kubernetes.io/name: db-mongo-mongo }
      spec:
        replicas: 1
        selector: { matchLabels: { app.kubernetes.io/name: db-mongo-mongo } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: db-mongo-mongo
              # DB tier is deliberately NOT an SG member (a SecurityGroup fences the
              # app's ingress port; on the DB it would blackhole the DB's own ports).
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: ferretdb
                image: ghcr.io/ferretdb/ferretdb:2
                env:
                  - name: FERRETDB_POSTGRESQL_URL
                    valueFrom: { secretKeyRef: { name: db-mongo-mongo-app, key: POSTGRESQL_URL } }
                ports: [ { containerPort: 27017 } ]
                resources:
                  requests: { cpu: 50m, memory: 128Mi }
                  limits: { cpu: "1", memory: 512Mi }
                readinessProbe: { tcpSocket: { port: 27017 }, initialDelaySeconds: 5, periodSeconds: 10 }
---
# FerretDB Service — the Mongo endpoint apps connect to (27017).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: mongo-svc
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      metadata: { name: db-mongo-mongo, namespace: team-b }
      spec:
        selector: { app.kubernetes.io/name: db-mongo-mongo }
        ports: [ { port: 27017, targetPort: 27017 } ]
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== db-mysql

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: db-mysql
        namespace: team-b
        labels: { app.kubernetes.io/name: db-mysql }
      spec:
        selector: { matchLabels: { app.kubernetes.io/name: db-mysql } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: db-mysql
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: app
                image: ghcr.io/me/shop:1
                # Each container port once per protocol ($containerPorts, deduped above);
                # the Service below keeps every Service port.
                ports:
                  - { containerPort: 8080 }
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 50m, memory: 64Mi }
                  limits: { cpu: 500m, memory: 512Mi }
                # Health checks auto-injected — k8s self-heals. The startup probe gives a slow
                # first boot (DB init, AV signature download) time to begin listening before
                # liveness can kill it: failureThreshold*10s ≈ startupGraceSeconds (default 150).
                # A port-less workload (a queue worker) renders NO probe — nothing listens, and
                # k8s still restarts it if the process exits.
                startupProbe:   { tcpSocket: { port: 8080 }, periodSeconds: 10, failureThreshold: 15 }
                readinessProbe: { tcpSocket: { port: 8080 } }
                livenessProbe:  { tcpSocket: { port: 8080 } }
                env:
                  # Injected MySQL connection (MariaDB endpoint).
                  - name: DATABASE_URL
                    valueFrom:
                      secretKeyRef: { name: db-mysql-mysql-app, key: DATABASE_URL }
---
# --- Service --- (only when the app exposes a port; a port-less worker has none).
#     The HTTP port (80 -> spec.port) plus any spec.additionalPorts — e.g. an SMTP 1025
#     or a second protocol an app serves beside its HTTP port. Multi-port Services need
#     named ports, so the HTTP port is named `http` (the Ingress references it by number).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: service
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      # Traefik runs on the host network: told to dial the Service's ClusterIP (nativelb) rather than a
      # pod IP, its connection reaches the pod from the kube-ovn join subnet, which the isolation policy admits.
      metadata: { name: db-mysql, namespace: team-b, annotations: { traefik.ingress.kubernetes.io/service.nativelb: "true" } }
      spec:
        selector: { app.kubernetes.io/name: db-mysql }
        ports:
          - { name: http, port: 80, targetPort: 8080 }
---
# --- HPA ("ASG") — only when there is room to scale (max > min). A fixed-size app
#     (min == max, e.g. {min: 1, max: 1}) gets NO HPA: an HPA with equal bounds has
#     nothing to do and just logs FailedGetResourceMetric/FailedComputeMetricsReplicas.
#     That fixed size is pinned as Deployment.replicas above (= $hpaMin). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: hpa
spec:
  forProvider:
    manifest:
      apiVersion: autoscaling/v2
      kind: HorizontalPodAutoscaler
      metadata: { name: db-mysql, namespace: team-b }
      spec:
        scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: db-mysql }
        minReplicas: 1
        maxReplicas: 5
        metrics:
          - type: Resource
            resource:
              name: cpu
              target: { type: Utilization, averageUtilization: 70 }
---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: db-mysql-limits, namespace: team-b }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: db-mysql-quota, namespace: team-b }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "100"
          persistentvolumeclaims: "60"
          services: "60"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: db-mysql-allow, namespace: team-b }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: db-mysql } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-b }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
---
# --- Tenant isolation (ingress) for the database tier: the app's netpol above selects only the
#     app's pods, and each engine labels its pods its own way, so the DB gets its own policy.
#     This namespace (the app, its jobs and snapshots), host-sourced traffic (NodePort /
#     LoadBalancer through kube-proxy; LAN publishing adds its own allow), the console and
#     Prometheus, and the engine's operator. Every other namespace is refused. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: db-netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata:
        name: db-mysql-db-isolation
        namespace: team-b
        labels: { openinfra.dev/isolation: tenant }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/instance: "db-mysql-mysql" } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # this namespace
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: team-b } }
              # host-sourced traffic (NodePort, LoadBalancer and external-IP Services through
              # kube-proxy) arrives as a node's kube-ovn join IP
              - ipBlock: { cidr: 100.64.0.0/16 }
              # the console (database stats, Peek, point-in-time restore)
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: open-infra-console } }
                podSelector: { matchLabels: { app: console } }
              # Prometheus, scraping metrics
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: monitoring } }
                podSelector: { matchLabels: { app.kubernetes.io/name: prometheus } }
              # the MariaDB operator (users, grants, replication)
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: mariadb-operator } }
---
# --- Relational ("RDS MySQL"): MariaDB via mariadb-operator (GPLv2 /
#     operator MIT). highAvailability -> 3-node Galera (synchronous,
#     auto-recovery); else a single instance. The operator owns the
#     StatefulSet + Services (primary svc is <name>-mysql). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: mysql-secret
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Secret
      metadata: { name: db-mysql-mysql-app, namespace: team-b }
      stringData:
        username: app
        password: "da0f1161c3f8184ec243d1de"
        rootPassword: "f3347de670064bff7c4a7536"
        database: "db-mysql"
        DATABASE_URL: "mysql://app:da0f1161c3f8184ec243d1de@db-mysql-mysql.team-b.svc.cluster.local:3306/db-mysql"
---
# MariaDB (operator CR). Operator provisions the StatefulSet, user,
# database, and Services from these refs.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: mysql
spec:
  forProvider:
    manifest:
      apiVersion: k8s.mariadb.com/v1alpha1
      kind: MariaDB
      metadata: { name: db-mysql-mysql, namespace: team-b }
      spec:
        # DB tier is deliberately NOT an SG member (a SecurityGroup fences the app's
        # ingress port; on the DB it would blackhole the DB's own ports).
        rootPasswordSecretKeyRef: { name: db-mysql-mysql-app, key: rootPassword }
        username: app
        passwordSecretKeyRef: { name: db-mysql-mysql-app, key: password }
        database: db-mysql
        port: 3306
        replicas: 1
        storage:
          size: 5Gi
          storageClassName: local-path
        resources:
          # Capacity from RDS DBInstanceClass (#114) when set; else the operator defaults.
          requests: { cpu: "500m", memory: "1Gi" }
          limits: { cpu: "500m", memory: "1Gi" }
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== db-babelfish

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: db-babelfish
        namespace: team-c
        labels: { app.kubernetes.io/name: db-babelfish }
      spec:
        selector: { matchLabels: { app.kubernetes.io/name: db-babelfish } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: db-babelfish
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: app
                image: ghcr.io/me/legacy:1
                # Each container port once per protocol ($containerPorts, deduped above);
                # the Service below keeps every Service port.
                ports:
                  - { containerPort: 8080 }
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 50m, memory: 64Mi }
                  limits: { cpu: 500m, memory: 512Mi }
                # Health checks auto-injected — k8s self-heals. The startup probe gives a slow
                # first boot (DB init, AV signature download) time to begin listening before
                # liveness can kill it: failureThreshold*10s ≈ startupGraceSeconds (default 150).
                # A port-less workload (a queue worker) renders NO probe — nothing listens, and
                # k8s still restarts it if the process exits.
                startupProbe:   { tcpSocket: { port: 8080 }, periodSeconds: 10, failureThreshold: 15 }
                readinessProbe: { tcpSocket: { port: 8080 } }
                livenessProbe:  { tcpSocket: { port: 8080 } }
                env:
                  # Injected Postgres connection (CloudNativePG app secret).
                  - name: DATABASE_URL
                    valueFrom:
                      secretKeyRef: { name: db-babelfish-db-app, key: uri }
---
# --- Service --- (only when the app exposes a port; a port-less worker has none).
#     The HTTP port (80 -> spec.port) plus any spec.additionalPorts — e.g. an SMTP 1025
#     or a second protocol an app serves beside its HTTP port. Multi-port Services need
#     named ports, so the HTTP port is named `http` (the Ingress references it by number).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: service
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      # Traefik runs on the host network: told to dial the Service's ClusterIP (nativelb) rather than a
      # pod IP, its connection reaches the pod from the kube-ovn join subnet, which the isolation policy admits.
      metadata: { name: db-babelfish, namespace: team-c, annotations: { traefik.ingress.kubernetes.io/service.nativelb: "true" } }
      spec:
        selector: { app.kubernetes.io/name: db-babelfish }
        ports:
          - { name: http, port: 80, targetPort: 8080 }
---
# --- HPA ("ASG") — only when there is room to scale (max > min). A fixed-size app
#     (min == max, e.g. {min: 1, max: 1}) gets NO HPA: an HPA with equal bounds has
#     nothing to do and just logs FailedGetResourceMetric/FailedComputeMetricsReplicas.
#     That fixed size is pinned as Deployment.replicas above (= $hpaMin). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: hpa
spec:
  forProvider:
    manifest:
      apiVersion: autoscaling/v2
      kind: HorizontalPodAutoscaler
      metadata: { name: db-babelfish, namespace: team-c }
      spec:
        scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: db-babelfish }
        minReplicas: 1
        maxReplicas: 5
        metrics:
          - type: Resource
            resource:
              name: cpu
              target: { type: Utilization, averageUtilization: 70 }
---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: db-babelfish-limits, namespace: team-c }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: db-babelfish-quota, namespace: team-c }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "100"
          persistentvolumeclaims: "60"
          services: "60"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: db-babelfish-allow, namespace: team-c }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: db-babelfish } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-c }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
---
# --- Tenant isolation (ingress) for the database tier: the app's netpol above selects only the
#     app's pods, and each engine labels its pods its own way, so the DB gets its own policy.
#     This namespace (the app, its jobs and snapshots), host-sourced traffic (NodePort /
#     LoadBalancer through kube-proxy; LAN publishing adds its own allow), the console and
#     Prometheus, and the engine's operator. Every other namespace is refused. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: db-netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata:
        name: db-babelfish-db-isolation
        namespace: team-c
        labels: { openinfra.dev/isolation: tenant }
      spec:
        podSelector: { matchLabels: { app: "db-babelfish-babelfish" } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # this namespace
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: team-c } }
              # host-sourced traffic (NodePort, LoadBalancer and external-IP Services through
              # kube-proxy) arrives as a node's kube-ovn join IP
              - ipBlock: { cidr: 100.64.0.0/16 }
              # the console (database stats, Peek, point-in-time restore)
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: open-infra-console } }
                podSelector: { matchLabels: { app: console } }
              # Prometheus, scraping metrics
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: monitoring } }
                podSelector: { matchLabels: { app.kubernetes.io/name: prometheus } }
---
# Connection secret — SQL Server (TDS) + native Postgres endpoints.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: babelfish-secret
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Secret
      metadata: { name: db-babelfish-babelfish, namespace: team-c }
      stringData:
        ENGINE: babelfish
        HOST: db-babelfish-babelfish.team-c.svc.cluster.local
        TDS_PORT: "1433"
        PG_PORT: "5432"
        USERNAME: appuser
        PASSWORD: "Bbf6c4bd2ccf328eb72a99x"
        DATABASE: "db-babelfish"
        # Point unmodified SQL Server / T-SQL apps here (TDS wire protocol).
        # TLS is on (cert-manager); TrustServerCertificate since it's the LAN CA.
        SQLSERVER_URL: "Server=db-babelfish-babelfish.team-c.svc.cluster.local,1433;Database=db-babelfish;User Id=appuser;Password=Bbf6c4bd2ccf328eb72a99x;Encrypt=mandatory;TrustServerCertificate=true"
        # Same data over the native Postgres wire protocol:
        DATABASE_URL: "postgres://appuser:Bbf6c4bd2ccf328eb72a99x@db-babelfish-babelfish.team-c.svc.cluster.local:5432/db-babelfish"
---
# TLS cert for the TDS + Postgres listeners (cert-manager, the LAN CA).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: babelfish-cert
spec:
  forProvider:
    manifest:
      apiVersion: cert-manager.io/v1
      kind: Certificate
      metadata: { name: db-babelfish-babelfish-tls, namespace: team-c }
      spec:
        secretName: db-babelfish-babelfish-tls
        duration: 8760h
        dnsNames:
          - db-babelfish-babelfish
          - db-babelfish-babelfish.team-c.svc
          - db-babelfish-babelfish.team-c.svc.cluster.local
        issuerRef: { name: openinfra-issuer, kind: ClusterIssuer }
---
# Babelfish server — StatefulSet on Longhorn, single instance. Stop => replicas 0.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: babelfish
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: StatefulSet
      metadata:
        name: db-babelfish-babelfish
        namespace: team-c
        labels: { app.kubernetes.io/name: db-babelfish-babelfish, openinfra.dev/managed-db: babelfish }
      spec:
        serviceName: db-babelfish-babelfish
        replicas: 1
        selector: { matchLabels: { app: db-babelfish-babelfish } }
        template:
          metadata:
            labels:
              app: db-babelfish-babelfish
              # DB tier is deliberately NOT an SG member (see the app-tier note).
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            # Fail-closed storage placement (#307): disk-class must be nvme or sata-ssd.
            affinity:
              nodeAffinity:
                requiredDuringSchedulingIgnoredDuringExecution:
                  nodeSelectorTerms:
                    - matchExpressions:
                        - { key: openinfra.dev/disk-class, operator: In, values: [nvme, sata-ssd] }
            securityContext: { fsGroup: 1000 }
            # Postgres refuses a root-owned data dir; chown the Longhorn PVC first.
            initContainers:
              - name: fix-perms
                image: ghcr.io/harn3ss/open-infra-babelfish:latest
                command: ["sh", "-c", "chown -R postgres:postgres /var/lib/babelfish/data && chmod 700 /var/lib/babelfish/data"]
                securityContext: { runAsUser: 0 }
                volumeMounts:
                  # subPath so PGDATA is a clean subdir below the ext4 lost+found
                  # (Longhorn volumes are ext4; initdb refuses a non-empty dir).
                  - { name: data, mountPath: /var/lib/babelfish/data, subPath: pgdata }
            containers:
              - name: babelfish
                image: ghcr.io/harn3ss/open-infra-babelfish:latest
                # start.sh inits on first boot (login + db via -p), then execs postgres.
                command: ["/bin/sh", "-c"]
                args:
                  - 'exec /start.sh -u appuser -p "$BF_PASS" -d "$BF_DB" -m single-db'
                env:
                  - name: BF_PASS
                    valueFrom: { secretKeyRef: { name: db-babelfish-babelfish, key: PASSWORD } }
                  - name: BF_DB
                    value: "db-babelfish"
                  - name: BABELFISH_TLS_DIR   # start.sh enables ssl when this cert exists
                    value: /certs
                ports:
                  - { containerPort: 1433, name: tds }
                  - { containerPort: 5432, name: pg }
                volumeMounts:
                  # subPath so PGDATA is a clean subdir below the ext4 lost+found
                  # (Longhorn volumes are ext4; initdb refuses a non-empty dir).
                  - { name: data, mountPath: /var/lib/babelfish/data, subPath: pgdata }
                  - { name: tls, mountPath: /certs, readOnly: true }
                resources:
                  # Capacity from RDS DBInstanceClass (#114) when set; else defaults.
                  requests: { cpu: "250m", memory: "512Mi" }
                  limits: { cpu: "2", memory: "2Gi" }
            volumes:
              - name: tls
                secret: { secretName: db-babelfish-babelfish-tls, defaultMode: 0640 }
        volumeClaimTemplates:
          - metadata: { name: data }
            spec:
              accessModes: [ReadWriteOnce]
              storageClassName: longhorn   # node-independent; back up with Velero
              resources: { requests: { storage: 10Gi } }
---
# Service — SQL Server (1433) + Postgres (5432). expose => LAN-reachable
# via the lan-expose controller (ClusterIP + annotation), not a broken
# MetalLB LoadBalancer.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: babelfish-svc
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      metadata:
        name: db-babelfish-babelfish
        namespace: team-c
      spec:
        type: ClusterIP
        selector: { app: db-babelfish-babelfish }
        ports:
          - { name: tds, port: 1433, targetPort: 1433 }
          - { name: pg, port: 5432, targetPort: 5432 }
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== db-sqlserver

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: db-sqlserver
        namespace: team-c
        labels: { app.kubernetes.io/name: db-sqlserver }
      spec:
        selector: { matchLabels: { app.kubernetes.io/name: db-sqlserver } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: db-sqlserver
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: app
                image: ghcr.io/me/legacy:2
                # Each container port once per protocol ($containerPorts, deduped above);
                # the Service below keeps every Service port.
                ports:
                  - { containerPort: 8080 }
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 50m, memory: 64Mi }
                  limits: { cpu: 500m, memory: 512Mi }
                # Health checks auto-injected — k8s self-heals. The startup probe gives a slow
                # first boot (DB init, AV signature download) time to begin listening before
                # liveness can kill it: failureThreshold*10s ≈ startupGraceSeconds (default 150).
                # A port-less workload (a queue worker) renders NO probe — nothing listens, and
                # k8s still restarts it if the process exits.
                startupProbe:   { tcpSocket: { port: 8080 }, periodSeconds: 10, failureThreshold: 15 }
                readinessProbe: { tcpSocket: { port: 8080 } }
                livenessProbe:  { tcpSocket: { port: 8080 } }
                env:
                  # Injected SQL Server connection (real MSSQL, TDS) — present only once the
                  # EULA is accepted and the engine is provisioned (else the engine is blocked).
                  - name: SQLSERVER_URL
                    valueFrom:
                      secretKeyRef: { name: db-sqlserver-sqlserver, key: SQLSERVER_URL }
---
# --- Service --- (only when the app exposes a port; a port-less worker has none).
#     The HTTP port (80 -> spec.port) plus any spec.additionalPorts — e.g. an SMTP 1025
#     or a second protocol an app serves beside its HTTP port. Multi-port Services need
#     named ports, so the HTTP port is named `http` (the Ingress references it by number).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: service
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      # Traefik runs on the host network: told to dial the Service's ClusterIP (nativelb) rather than a
      # pod IP, its connection reaches the pod from the kube-ovn join subnet, which the isolation policy admits.
      metadata: { name: db-sqlserver, namespace: team-c, annotations: { traefik.ingress.kubernetes.io/service.nativelb: "true" } }
      spec:
        selector: { app.kubernetes.io/name: db-sqlserver }
        ports:
          - { name: http, port: 80, targetPort: 8080 }
---
# --- HPA ("ASG") — only when there is room to scale (max > min). A fixed-size app
#     (min == max, e.g. {min: 1, max: 1}) gets NO HPA: an HPA with equal bounds has
#     nothing to do and just logs FailedGetResourceMetric/FailedComputeMetricsReplicas.
#     That fixed size is pinned as Deployment.replicas above (= $hpaMin). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: hpa
spec:
  forProvider:
    manifest:
      apiVersion: autoscaling/v2
      kind: HorizontalPodAutoscaler
      metadata: { name: db-sqlserver, namespace: team-c }
      spec:
        scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: db-sqlserver }
        minReplicas: 1
        maxReplicas: 5
        metrics:
          - type: Resource
            resource:
              name: cpu
              target: { type: Utilization, averageUtilization: 70 }
---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: db-sqlserver-limits, namespace: team-c }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: db-sqlserver-quota, namespace: team-c }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "100"
          persistentvolumeclaims: "60"
          services: "60"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: db-sqlserver-allow, namespace: team-c }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: db-sqlserver } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-c }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
---
# --- Tenant isolation (ingress) for the database tier: the app's netpol above selects only the
#     app's pods, and each engine labels its pods its own way, so the DB gets its own policy.
#     This namespace (the app, its jobs and snapshots), host-sourced traffic (NodePort /
#     LoadBalancer through kube-proxy; LAN publishing adds its own allow), the console and
#     Prometheus, and the engine's operator. Every other namespace is refused. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: db-netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata:
        name: db-sqlserver-db-isolation
        namespace: team-c
        labels: { openinfra.dev/isolation: tenant }
      spec:
        podSelector: { matchLabels: { app: "db-sqlserver-sqlserver" } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # this namespace
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: team-c } }
              # host-sourced traffic (NodePort, LoadBalancer and external-IP Services through
              # kube-proxy) arrives as a node's kube-ovn join IP
              - ipBlock: { cidr: 100.64.0.0/16 }
              # the console (database stats, Peek, point-in-time restore)
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: open-infra-console } }
                podSelector: { matchLabels: { app: console } }
              # Prometheus, scraping metrics
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: monitoring } }
                podSelector: { matchLabels: { app.kubernetes.io/name: prometheus } }
---
# Connection secret (TDS). SA credential; the target DATABASE is created/restored into this
# instance (a fresh MSSQL has only the system DBs, so connect to master first).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: sqlserver-secret
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Secret
      metadata: { name: db-sqlserver-sqlserver, namespace: team-c }
      stringData:
        ENGINE: sqlserver
        EDITION: "Express"
        HOST: db-sqlserver-sqlserver.team-c.svc.cluster.local
        TDS_PORT: "1433"
        USERNAME: sa
        PASSWORD: "Mssql-0e4d0aafd047341c-9Z"
        DATABASE: "db-sqlserver"
        SQLSERVER_URL: "Server=db-sqlserver-sqlserver.team-c.svc.cluster.local,1433;Database=master;User Id=sa;Password=Mssql-0e4d0aafd047341c-9Z;Encrypt=mandatory;TrustServerCertificate=true"
---
# Restore script for the sidecar: wait for the engine, then RESTORE the staged .bak once
# (idempotent — skipped if the DB already exists). FILELISTONLY is parsed in shell (robust
# to SQL's column count) to auto-generate WITH MOVE into the data volume.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: sqlserver-restore-script
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ConfigMap
      metadata: { name: db-sqlserver-sqlserver-restore, namespace: team-c }
      data:
        restore.sh: |
          #!/usr/bin/env bash
          # Restores the staged .bak ONCE, then idles ready. A readiness sentinel (/restore/.done)
          # gates this sidecar's readiness probe, so the pod — and therefore the Service endpoint
          # and the claim — is NOT Ready until the restore actually completes. A failure exits
          # NON-ZERO (set -e), so the container crashloops NotReady with the reason in its logs /
          # terminationMessage, instead of sleeping and letting the claim look healthy.
          set -euo pipefail
          SQLCMD=/opt/mssql-tools18/bin/sqlcmd
          DB='db-sqlserver'
          BAK=/restore/db.bak
          DONE=/restore/.done
          rm -f "$DONE"
          q(){ "$SQLCMD" -S localhost -U sa -P "$MSSQL_SA_PASSWORD" -C -b "$@"; }
          echo "restore: waiting for SQL Server..."
          until q -l 2 -Q "SELECT 1" >/dev/null 2>&1; do sleep 5; done
          exists=$(q -h -1 -W -Q "SET NOCOUNT ON; SELECT ISNULL(CONVERT(varchar(12),DB_ID(N'$DB')),'NULL')" | tr -d '[:space:]')
          if [ "$exists" != "NULL" ]; then echo "restore: '$DB' already present — nothing to do"; touch "$DONE"; exec sleep infinity; fi
          # fetch-bak (an init container) must have staged the file; if it is missing here the
          # restore cannot proceed — fail loudly (NotReady) rather than idle and look done.
          if [ ! -s "$BAK" ]; then echo "restore: $BAK not staged (fetch-bak failed?)" >&2; exit 1; fi
          echo "restore: building MOVE from the backup file list..."
          MOVES=""
          while IFS='~' read -r logical _phys typ _rest; do
            logical=$(printf '%s' "$logical" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            typ=$(printf '%s' "$typ" | tr -d '[:space:]')
            [ -z "$logical" ] && continue
            ext=.mdf; [ "$typ" = "L" ] && ext=.ldf
            MOVES="$MOVES, MOVE N'$logical' TO N'/var/opt/mssql/data/${DB}_${logical}${ext}'"
          done < <(q -s '~' -W -h -1 -Q "SET NOCOUNT ON; RESTORE FILELISTONLY FROM DISK=N'$BAK'")
          echo "restore: restoring '$DB'$MOVES"
          q -Q "RESTORE DATABASE [$DB] FROM DISK=N'$BAK' WITH REPLACE, RECOVERY$MOVES"
          # A restored DB keeps the backup's recovery model (usually FULL); force it to the configured
          # model so the transaction log can't run away and fill the volume/node (default SIMPLE).
          echo "restore: setting recovery model FULL"
          q -Q "ALTER DATABASE [$DB] SET RECOVERY FULL;"
          # also set the instance's model DB so any database created later inherits it (best-effort)
          "$SQLCMD" -S localhost -U sa -P "$MSSQL_SA_PASSWORD" -C -Q "ALTER DATABASE [model] SET RECOVERY FULL;" || echo "restore: note: could not set model recovery model"
          echo "restore: complete — reclaiming staged backup"
          rm -f "$BAK"   # free the staging space on the data volume now the DB is restored
          touch "$DONE"
          exec sleep infinity
---
# SQL Server — StatefulSet on Longhorn, single instance. Stop => replicas 0.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: sqlserver
spec:
  # Derive readiness from the StatefulSet's readyReplicas, NOT the provider default (ready as soon
  # as the object is CREATED). The restore sidecar's readiness gate holds readyReplicas at 0 until
  # the restore completes, so this makes the XR/claim stay NotReady through the restore — and a
  # failed restore surface as a NotReady claim — instead of reporting a silently-healthy claim while
  # the database is still (or never) being restored. replicas 0 (stopped) counts as ready.
  readiness:
    policy: DeriveFromCelQuery
    celQuery: object.spec.replicas == 0 || (has(object.status) && has(object.status.readyReplicas) && object.status.readyReplicas == object.spec.replicas)
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: StatefulSet
      metadata:
        name: db-sqlserver-sqlserver
        namespace: team-c
        labels: { app.kubernetes.io/name: db-sqlserver-sqlserver, openinfra.dev/managed-db: sqlserver }
        annotations:
          openinfra.dev/mssql-edition: "Express"
      spec:
        serviceName: db-sqlserver-sqlserver
        replicas: 1
        selector: { matchLabels: { app: db-sqlserver-sqlserver } }
        template:
          metadata:
            labels: { app: db-sqlserver-sqlserver }
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            nodeSelector:
              openinfra.dev/disk-class: "nvme"
            # Fail-closed storage placement (#307): disk-class must be nvme or sata-ssd.
            affinity:
              nodeAffinity:
                requiredDuringSchedulingIgnoredDuringExecution:
                  nodeSelectorTerms:
                    - matchExpressions:
                        - { key: openinfra.dev/disk-class, operator: In, values: [nvme, sata-ssd] }
            # SQL Server runs as uid 10001 and must own its data dir; chown the fresh
            # Longhorn PVC first (fsGroup + an explicit chown, same pattern as babelfish).
            securityContext: { fsGroup: 10001 }
            initContainers:
              # Capacity preflight (restore path): neither local-path nor Longhorn does
              # storage-capacity-aware scheduling (local-path isn't CSI; driver.longhorn.io
              # reports STORAGECAPACITY=false), so a size larger than the node/volume can hold
              # would otherwise bind anywhere the pod fits by CPU/memory and only surface as
              # ENOSPC mid-RESTORE — hours in, with the claim still looking healthy. A RESTORE
              # needs the full database size available immediately, so fail FAST and LOUD here,
              # on the actually-scheduled node, with a reason an operator can act on, before any
              # data (or the staged .bak) is written. (A fresh DB grows into its size over time,
              # so this check is restore-only; size guidance for fresh DBs is in the docs.)
              - name: capacity-preflight
                image: mcr.microsoft.com/mssql/server:2022-latest
                command:
                  - sh
                  - -c
                  - |
                    set -e
                    NEED='50Gi'
                    to_bytes() { n=$(printf '%s' "$1" | sed 's/[A-Za-z].*//'); u=$(printf '%s' "$1" | sed 's/^[0-9.]*//'); case "$u" in Ki) f=1024;; Mi) f=1048576;; Gi) f=1073741824;; Ti) f=1099511627776;; Pi) f=1125899906842624;; k|K) f=1000;; M) f=1000000;; G) f=1000000000;; T) f=1000000000000;; "") f=1;; *) f=1;; esac; awk -v n="$n" -v f="$f" 'BEGIN{printf "%.0f", n*f}'; }
                    need=$(to_bytes "$NEED")
                    # A formatted volume's USABLE space is a few % below its nominal size (ext4
                    # reserve + metadata/journal), and Longhorn provisions exactly `size`, so a
                    # correctly-sized volume reports df-free slightly under `size`. Compare against
                    # ~90% of size: enough headroom to catch a GROSSLY undersized node/volume (the
                    # real local-path risk, e.g. a 237GB node for a 499Gi DB) without false-
                    # rejecting a right-sized volume on filesystem overhead alone.
                    floor=$(awk -v n="$need" 'BEGIN{printf "%.0f", n*0.9}')
                    avail=$(df -PB1 /var/opt/mssql | awk 'NR==2{print $4}')
                    node="${NODE_NAME:-this node}"
                    printf 'capacity-preflight: database size=%s (%s bytes, floor %s after fs overhead); data volume has %s bytes free on %s\n' "$NEED" "$need" "$floor" "$avail" "$node"
                    if [ "$avail" -lt "$floor" ]; then
                      echo "capacity-preflight: INSUFFICIENT STORAGE — a RESTORE of size $NEED needs ~$floor usable bytes but only $avail are free on $node. Set spec.database.placement to a node with room, use a larger storageClass/volume, or reduce spec.database.size. Refusing to start so the restore does not ENOSPC mid-flight." >&2
                      exit 1
                    fi
                    echo "capacity-preflight: OK"
                env:
                  - { name: NODE_NAME, valueFrom: { fieldRef: { fieldPath: spec.nodeName } } }
                volumeMounts:
                  - { name: data, mountPath: /var/opt/mssql, subPath: mssql }
              - name: fix-perms
                image: mcr.microsoft.com/mssql/server:2022-latest
                securityContext: { runAsUser: 0 }
                # Restoring: own BOTH subdirs on the data volume — mssql (the engine data root, a
                # clean subdir below the ext4 lost+found) and restore (the .bak staging dir, which
                # the non-root fetch-bak writes to — see fetch-bak).
                command: ["sh", "-c", "mkdir -p /data/mssql /data/restore && chown -R 10001:0 /data/mssql /data/restore && chmod 770 /data/mssql /data/restore"]
                volumeMounts:
                  - { name: data, mountPath: /data }
              # Stage the .bak onto the sized DATA volume (subPath restore), NOT a node emptyDir:
              # a .bak staged to node-ephemeral storage can fill the node's disk (and evict pods)
              # independent of the PVC, and it needs headroom on top of the restored data. Staging
              # on the data volume makes an over-large backup fail as a clear volume-full error
              # here, and the restore reclaims it (rm) once the database is in place.
              - name: fetch-bak
                image: ghcr.io/harn3ss/open-infra-mc:latest
                command: ["sh", "-c", "[ -f /restore/.done ] && { echo 'fetch-bak: restore already complete — skipping download'; exit 0; }; mc alias set src \"$S3_ENDPOINT\" \"$S3_ACCESS_KEY\" \"$S3_SECRET_KEY\" && mc cp \"src/migrations/estate/db.bak\" /restore/db.bak && ls -l /restore/db.bak"]
                env: [ { name: HOME, value: /tmp } ]   # mc writes its config to $HOME/.mc — / is not writable under the non-root pod
                envFrom: [ { secretRef: { name: migr-s3 } } ]
                securityContext: { runAsUser: 10001 }   # match the fix-perms ownership of subPath restore
                volumeMounts: [ { name: data, mountPath: /restore, subPath: restore } ]
            containers:
              - name: sqlserver
                image: mcr.microsoft.com/mssql/server:2022-latest
                env:
                  - { name: ACCEPT_EULA, value: "Y" }
                  - { name: MSSQL_PID, value: "Express" }
                  - name: MSSQL_SA_PASSWORD
                    valueFrom: { secretKeyRef: { name: db-sqlserver-sqlserver, key: PASSWORD } }
                ports:
                  - { containerPort: 1433, name: tds }
                volumeMounts:
                  - { name: data, mountPath: /var/opt/mssql, subPath: mssql }
                  # The engine reads the staged .bak at /restore (RESTORE FROM DISK resolves the
                  # path in THIS process), backed by the sized data volume's restore subPath.
                  - { name: data, mountPath: /restore, subPath: restore }
                readinessProbe: { tcpSocket: { port: 1433 }, initialDelaySeconds: 20, periodSeconds: 10 }
                livenessProbe:  { tcpSocket: { port: 1433 }, initialDelaySeconds: 60, periodSeconds: 20 }
                resources:
                  # SQL Server needs >=2Gi to start; size database.memory to the workload (8Gi+).
                  requests: { cpu: "500m", memory: "4Gi" }
                  limits: { cpu: "2", memory: "4Gi" }
              # Restore sidecar: waits for the engine, then RESTOREs the staged .bak once. Its
              # readiness gates the POD (and therefore the Service endpoint + the claim): NotReady
              # until the restore actually completes (sentinel /restore/.done), and it crashloops
              # NotReady — with the reason in its terminationMessage/logs — if the restore fails,
              # so a failed restore surfaces as a NotReady claim instead of a silently-healthy one.
              - name: restore
                image: mcr.microsoft.com/mssql/server:2022-latest
                command: ["bash", "/opt/restore/restore.sh"]
                terminationMessagePolicy: FallbackToLogsOnError
                env:
                  - name: MSSQL_SA_PASSWORD
                    valueFrom: { secretKeyRef: { name: db-sqlserver-sqlserver, key: PASSWORD } }
                readinessProbe:
                  exec: { command: ["sh", "-c", "test -f /restore/.done"] }
                  initialDelaySeconds: 10
                  periodSeconds: 10
                  failureThreshold: 1
                volumeMounts:
                  - { name: data, mountPath: /restore, subPath: restore }
                  - { name: restore-script, mountPath: /opt/restore, readOnly: true }
            volumes:
              - name: restore-script
                configMap: { name: db-sqlserver-sqlserver-restore, defaultMode: 0755, items: [ { key: restore.sh, path: restore.sh } ] }
        volumeClaimTemplates:
          - metadata: { name: data }
            spec:
              accessModes: [ReadWriteOnce]
              storageClassName: longhorn   # node-independent; back up with Velero
              resources: { requests: { storage: 50Gi } }
---
# Service — TDS 1433. The name <name>-sqlserver is exactly what kind: DatabaseProxy
# (engineFamily: sqlserver) fronts. expose => LAN-reachable via the lan-expose controller.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: sqlserver-svc
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      metadata:
        name: db-sqlserver-sqlserver
        namespace: team-c
      spec:
        type: ClusterIP
        selector: { app: db-sqlserver-sqlserver }
        ports:
          - { name: tds, port: 1433, targetPort: 1433 }
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== db-sqlserver-no-eula

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: db-sqlserver-no-eula
        namespace: team-c
        labels: { app.kubernetes.io/name: db-sqlserver-no-eula }
      spec:
        selector: { matchLabels: { app.kubernetes.io/name: db-sqlserver-no-eula } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: db-sqlserver-no-eula
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: app
                image: ghcr.io/me/legacy:2
                # Each container port once per protocol ($containerPorts, deduped above);
                # the Service below keeps every Service port.
                ports:
                  - { containerPort: 8080 }
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 50m, memory: 64Mi }
                  limits: { cpu: 500m, memory: 512Mi }
                # Health checks auto-injected — k8s self-heals. The startup probe gives a slow
                # first boot (DB init, AV signature download) time to begin listening before
                # liveness can kill it: failureThreshold*10s ≈ startupGraceSeconds (default 150).
                # A port-less workload (a queue worker) renders NO probe — nothing listens, and
                # k8s still restarts it if the process exits.
                startupProbe:   { tcpSocket: { port: 8080 }, periodSeconds: 10, failureThreshold: 15 }
                readinessProbe: { tcpSocket: { port: 8080 } }
                livenessProbe:  { tcpSocket: { port: 8080 } }
                env:
---
# --- Service --- (only when the app exposes a port; a port-less worker has none).
#     The HTTP port (80 -> spec.port) plus any spec.additionalPorts — e.g. an SMTP 1025
#     or a second protocol an app serves beside its HTTP port. Multi-port Services need
#     named ports, so the HTTP port is named `http` (the Ingress references it by number).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: service
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      # Traefik runs on the host network: told to dial the Service's ClusterIP (nativelb) rather than a
      # pod IP, its connection reaches the pod from the kube-ovn join subnet, which the isolation policy admits.
      metadata: { name: db-sqlserver-no-eula, namespace: team-c, annotations: { traefik.ingress.kubernetes.io/service.nativelb: "true" } }
      spec:
        selector: { app.kubernetes.io/name: db-sqlserver-no-eula }
        ports:
          - { name: http, port: 80, targetPort: 8080 }
---
# --- HPA ("ASG") — only when there is room to scale (max > min). A fixed-size app
#     (min == max, e.g. {min: 1, max: 1}) gets NO HPA: an HPA with equal bounds has
#     nothing to do and just logs FailedGetResourceMetric/FailedComputeMetricsReplicas.
#     That fixed size is pinned as Deployment.replicas above (= $hpaMin). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: hpa
spec:
  forProvider:
    manifest:
      apiVersion: autoscaling/v2
      kind: HorizontalPodAutoscaler
      metadata: { name: db-sqlserver-no-eula, namespace: team-c }
      spec:
        scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: db-sqlserver-no-eula }
        minReplicas: 1
        maxReplicas: 5
        metrics:
          - type: Resource
            resource:
              name: cpu
              target: { type: Utilization, averageUtilization: 70 }
---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: db-sqlserver-no-eula-limits, namespace: team-c }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: db-sqlserver-no-eula-quota, namespace: team-c }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "100"
          persistentvolumeclaims: "60"
          services: "60"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: db-sqlserver-no-eula-allow, namespace: team-c }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: db-sqlserver-no-eula } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-c }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
---
# --- Tenant isolation (ingress) for the database tier: the app's netpol above selects only the
#     app's pods, and each engine labels its pods its own way, so the DB gets its own policy.
#     This namespace (the app, its jobs and snapshots), host-sourced traffic (NodePort /
#     LoadBalancer through kube-proxy; LAN publishing adds its own allow), the console and
#     Prometheus, and the engine's operator. Every other namespace is refused. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: db-netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata:
        name: db-sqlserver-no-eula-db-isolation
        namespace: team-c
        labels: { openinfra.dev/isolation: tenant }
      spec:
        podSelector: { matchLabels: { app: "db-sqlserver-no-eula-sqlserver" } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # this namespace
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: team-c } }
              # host-sourced traffic (NodePort, LoadBalancer and external-IP Services through
              # kube-proxy) arrives as a node's kube-ovn join IP
              - ipBlock: { cidr: 100.64.0.0/16 }
              # the console (database stats, Peek, point-in-time restore)
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: open-infra-console } }
                podSelector: { matchLabels: { app: console } }
              # Prometheus, scraping metrics
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: monitoring } }
                podSelector: { matchLabels: { app.kubernetes.io/name: prometheus } }
---
# Fail-closed: engine=sqlserver requires database.acceptEula=true (Microsoft EULA). No
# proprietary image is pulled and no database is provisioned until it is set.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: sqlserver-blocked
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: db-sqlserver-no-eula-sqlserver-blocked
        namespace: team-c
        labels: { openinfra.dev/managed-db: sqlserver, openinfra.dev/blocked: "eula-not-accepted" }
      data:
        reason: "engine=sqlserver requires spec.database.acceptEula=true to accept Microsoft's SQL Server EULA. Nothing is provisioned until then."
        eula: "https://go.microsoft.com/fwlink/?linkid=857698"
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== db-only-stopped

