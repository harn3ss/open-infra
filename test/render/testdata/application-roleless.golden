=== image-minimal

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: image-minimal
        namespace: team-a
        labels: { app.kubernetes.io/name: image-minimal }
      spec:
        selector: { matchLabels: { app.kubernetes.io/name: image-minimal } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: image-minimal
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: app
                image: ghcr.io/me/hello:1
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 50m, memory: 64Mi }
                  limits: { cpu: 500m, memory: 512Mi }
---
# --- HPA ("ASG") — only when there is room to scale (max > min). A fixed-size app
#     (min == max, e.g. {min: 1, max: 1}) gets NO HPA: an HPA with equal bounds has
#     nothing to do and just logs FailedGetResourceMetric/FailedComputeMetricsReplicas.
#     That fixed size is pinned as Deployment.replicas above (= $hpaMin). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: hpa
spec:
  forProvider:
    manifest:
      apiVersion: autoscaling/v2
      kind: HorizontalPodAutoscaler
      metadata: { name: image-minimal, namespace: team-a }
      spec:
        scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: image-minimal }
        minReplicas: 1
        maxReplicas: 5
        metrics:
          - type: Resource
            resource:
              name: cpu
              target: { type: Utilization, averageUtilization: 70 }
---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: image-minimal-limits, namespace: team-a }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: image-minimal-quota, namespace: team-a }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "100"
          persistentvolumeclaims: "60"
          services: "60"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: image-minimal-allow, namespace: team-a }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: image-minimal } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-a }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== web-full

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: web-full
        namespace: team-a
        labels: { app.kubernetes.io/name: web-full }
      spec:
        selector: { matchLabels: { app.kubernetes.io/name: web-full } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: web-full
              openinfra.dev/sg-web: ""
              openinfra.dev/sg-db-clients: ""
            annotations:
              # Place the app in a kind: Subnet (kube-ovn): the pod draws its IP from that
              # subnet and inherits its OVN-enforced isolation — the AWS "in this subnet" model.
              ovn.kubernetes.io/logical_switch: private-a
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: app
                image: ghcr.io/me/api:2
                command: ["/app/server"]
                args: ["--listen",":8080"]
                # Each container port once per protocol ($containerPorts, deduped above);
                # the Service below keeps every Service port.
                ports:
                  - { containerPort: 8080 }
                  - { containerPort: 1025 }
                  - { containerPort: 9100 }
                  - { containerPort: 53, protocol: UDP }
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 500m, memory: 1Gi }
                  limits: { cpu: 500m, memory: 1Gi }
                # Health checks auto-injected — k8s self-heals. The startup probe gives a slow
                # first boot (DB init, AV signature download) time to begin listening before
                # liveness can kill it: failureThreshold*10s ≈ startupGraceSeconds (default 150).
                # A port-less workload (a queue worker) renders NO probe — nothing listens, and
                # k8s still restarts it if the process exits.
                startupProbe:   { tcpSocket: { port: 8080 }, periodSeconds: 10, failureThreshold: 5 }
                readinessProbe: { tcpSocket: { port: 8080 } }
                livenessProbe:  { tcpSocket: { port: 8080 } }
                env:
                  - { name: MODE, value: "fast" }
                  - { name: Q, value: "say \"hi\"" }
                envFrom:
                  - secretRef: { name: api-config, optional: true }
                  - secretRef: { name: api-keys, optional: true }
---
# --- Service --- (only when the app exposes a port; a port-less worker has none).
#     The HTTP port (80 -> spec.port) plus any spec.additionalPorts — e.g. an SMTP 1025
#     or a second protocol an app serves beside its HTTP port. Multi-port Services need
#     named ports, so the HTTP port is named `http` (the Ingress references it by number).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: service
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      # Traefik runs on the host network: told to dial the Service's ClusterIP (nativelb) rather than a
      # pod IP, its connection reaches the pod from the kube-ovn join subnet, which the isolation policy admits.
      metadata: { name: web-full, namespace: team-a, annotations: { traefik.ingress.kubernetes.io/service.nativelb: "true" } }
      spec:
        selector: { app.kubernetes.io/name: web-full }
        ports:
          - { name: http, port: 80, targetPort: 8080 }
          - { name: smtp, port: 1025, targetPort: 1025 }
          - { name: metrics, port: 9090, targetPort: 9100 }
          - { name: dns, port: 53, targetPort: 53, protocol: UDP }
---
# --- Ingress (Traefik) + TLS via cert-manager ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: ingress
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: Ingress
      metadata:
        name: web-full
        namespace: team-a
        annotations:
          cert-manager.io/cluster-issuer: openinfra-issuer
      spec:
        rules:
          - host: api.example.com
            http:
              paths:
                - path: /
                  pathType: Prefix
                  backend: { service: { name: web-full, port: { number: 80 } } }
        tls:
          - hosts: [ api.example.com ]
            secretName: web-full-tls
---
# --- HPA ("ASG") — only when there is room to scale (max > min). A fixed-size app
#     (min == max, e.g. {min: 1, max: 1}) gets NO HPA: an HPA with equal bounds has
#     nothing to do and just logs FailedGetResourceMetric/FailedComputeMetricsReplicas.
#     That fixed size is pinned as Deployment.replicas above (= $hpaMin). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: hpa
spec:
  forProvider:
    manifest:
      apiVersion: autoscaling/v2
      kind: HorizontalPodAutoscaler
      metadata: { name: web-full, namespace: team-a }
      spec:
        scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: web-full }
        minReplicas: 2
        maxReplicas: 10
        metrics:
          - type: Resource
            resource:
              name: cpu
              target: { type: Utilization, averageUtilization: 60 }
---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: web-full-limits, namespace: team-a }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: web-full-quota, namespace: team-a }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "120"
          persistentvolumeclaims: "40"
          services: "80"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: web-full-allow, namespace: team-a }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: web-full } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-a }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== fixed-size

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: fixed-size
        namespace: team-a
        labels: { app.kubernetes.io/name: fixed-size }
      spec:
        # No HPA (max <= min): the HPA owns the replica count only when it can scale,
        # so a fixed-size app must set replicas on the Deployment — otherwise
        # min == max > 1 runs a single replica. When an HPA IS rendered, replicas is
        # omitted on purpose, so the Deployment and the HPA don't fight over the count.
        replicas: 3
        selector: { matchLabels: { app.kubernetes.io/name: fixed-size } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: fixed-size
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: app
                image: ghcr.io/me/api:2
                # Each container port once per protocol ($containerPorts, deduped above);
                # the Service below keeps every Service port.
                ports:
                  - { containerPort: 8080 }
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 50m, memory: 64Mi }
                  limits: { cpu: 500m, memory: 512Mi }
                # Health checks auto-injected — k8s self-heals. The startup probe gives a slow
                # first boot (DB init, AV signature download) time to begin listening before
                # liveness can kill it: failureThreshold*10s ≈ startupGraceSeconds (default 150).
                # A port-less workload (a queue worker) renders NO probe — nothing listens, and
                # k8s still restarts it if the process exits.
                startupProbe:   { tcpSocket: { port: 8080 }, periodSeconds: 10, failureThreshold: 15 }
                readinessProbe: { tcpSocket: { port: 8080 } }
                livenessProbe:  { tcpSocket: { port: 8080 } }
---
# --- Service --- (only when the app exposes a port; a port-less worker has none).
#     The HTTP port (80 -> spec.port) plus any spec.additionalPorts — e.g. an SMTP 1025
#     or a second protocol an app serves beside its HTTP port. Multi-port Services need
#     named ports, so the HTTP port is named `http` (the Ingress references it by number).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: service
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      # Traefik runs on the host network: told to dial the Service's ClusterIP (nativelb) rather than a
      # pod IP, its connection reaches the pod from the kube-ovn join subnet, which the isolation policy admits.
      metadata: { name: fixed-size, namespace: team-a, annotations: { traefik.ingress.kubernetes.io/service.nativelb: "true" } }
      spec:
        selector: { app.kubernetes.io/name: fixed-size }
        ports:
          - { name: http, port: 80, targetPort: 8080 }
---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: fixed-size-limits, namespace: team-a }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: fixed-size-quota, namespace: team-a }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "100"
          persistentvolumeclaims: "60"
          services: "60"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: fixed-size-allow, namespace: team-a }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: fixed-size } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-a }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== startup-zero

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: startup-zero
        namespace: team-a
        labels: { app.kubernetes.io/name: startup-zero }
      spec:
        selector: { matchLabels: { app.kubernetes.io/name: startup-zero } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: startup-zero
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: app
                image: ghcr.io/me/api:2
                # Each container port once per protocol ($containerPorts, deduped above);
                # the Service below keeps every Service port.
                ports:
                  - { containerPort: 8080 }
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 50m, memory: 64Mi }
                  limits: { cpu: 500m, memory: 512Mi }
                # Health checks auto-injected — k8s self-heals. The startup probe gives a slow
                # first boot (DB init, AV signature download) time to begin listening before
                # liveness can kill it: failureThreshold*10s ≈ startupGraceSeconds (default 150).
                # A port-less workload (a queue worker) renders NO probe — nothing listens, and
                # k8s still restarts it if the process exits.
                startupProbe:   { tcpSocket: { port: 8080 }, periodSeconds: 10, failureThreshold: 1 }
                readinessProbe: { tcpSocket: { port: 8080 } }
                livenessProbe:  { tcpSocket: { port: 8080 } }
---
# --- Service --- (only when the app exposes a port; a port-less worker has none).
#     The HTTP port (80 -> spec.port) plus any spec.additionalPorts — e.g. an SMTP 1025
#     or a second protocol an app serves beside its HTTP port. Multi-port Services need
#     named ports, so the HTTP port is named `http` (the Ingress references it by number).
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: service
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: Service
      # Traefik runs on the host network: told to dial the Service's ClusterIP (nativelb) rather than a
      # pod IP, its connection reaches the pod from the kube-ovn join subnet, which the isolation policy admits.
      metadata: { name: startup-zero, namespace: team-a, annotations: { traefik.ingress.kubernetes.io/service.nativelb: "true" } }
      spec:
        selector: { app.kubernetes.io/name: startup-zero }
        ports:
          - { name: http, port: 80, targetPort: 8080 }
---
# --- HPA ("ASG") — only when there is room to scale (max > min). A fixed-size app
#     (min == max, e.g. {min: 1, max: 1}) gets NO HPA: an HPA with equal bounds has
#     nothing to do and just logs FailedGetResourceMetric/FailedComputeMetricsReplicas.
#     That fixed size is pinned as Deployment.replicas above (= $hpaMin). ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: hpa
spec:
  forProvider:
    manifest:
      apiVersion: autoscaling/v2
      kind: HorizontalPodAutoscaler
      metadata: { name: startup-zero, namespace: team-a }
      spec:
        scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: startup-zero }
        minReplicas: 1
        maxReplicas: 5
        metrics:
          - type: Resource
            resource:
              name: cpu
              target: { type: Utilization, averageUtilization: 70 }
---
# --- Tenant isolation: per-container defaults + max size (so the
#     count quota below never rejects a pod for missing resources) ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: limitrange
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: LimitRange
      metadata: { name: startup-zero-limits, namespace: team-a }
      spec:
        limits:
          # Only default *requests* — deliberately NO default limit and NO
          # max ceiling. A LimitRange is namespace-wide, so a default limit
          # or max would also hit co-located KubeVirt virt-launcher pods,
          # which legitimately request many CPUs / GiB, and reject them with
          # "request greater than limit" (a stray app's 512Mi default limit
          # once blocked a 12 GiB VM in the same namespace). App containers
          # set their own limits in the Deployment above; total namespace
          # usage is bounded by the ResourceQuota.
          - type: Container
            defaultRequest: { cpu: 50m, memory: 64Mi }
---
# --- Tenant isolation: object-count quota (counts only — safe; never
#     blocks pods for missing requests/limits).
#     NOTE: a ResourceQuota is NAMESPACE-scoped, so every app's quota caps
#     the WHOLE namespace and the most restrictive one wins. When several
#     apps/VMs share a namespace (e.g. `default`) these stack up fast — and
#     it isn't just app Services: KubeVirt VMs add a `-lan` Service and CDI
#     creates a transient `cdi-upload-*` Service per disk clone, so a low cap
#     silently wedges VM provisioning (clone stuck in CloneScheduled). Keep
#     these ceilings generous; they exist to stop runaway loops, not to size
#     the namespace. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: quota
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ResourceQuota
      metadata: { name: startup-zero-quota, namespace: team-a }
      spec:
        hard:
          # Generous safety ceilings (stop runaway loops), overridable per-app via spec.quota —
          # a namespace holding many Knative Functions needs a high `services` cap (~3/function).
          pods: "100"
          persistentvolumeclaims: "60"
          services: "60"
---
# --- Tenant isolation: restrict ingress to the app's pods to the same
#     namespace + the ingress controller (kube-system) + the kube-ovn join
#     subnet. Egress stays open so DNS / DB / MinIO / NATS keep working.
#     (kube-ovn exempts kubelet health probes, verified.)
#
#     Pod->Service (ClusterIP) calls keep the caller's pod IP (install.sh runs
#     kube-ovn with enable-lb=true), so the namespaceSelectors below are what
#     separate tenants: another namespace calling this app's Service is denied.
#     The join subnet (100.64.0.0/16, set by install.sh) is still REQUIRED for
#     HOST-sourced traffic, which reaches pods as a node's join IP: hostNetwork
#     ingress (Traefik) and NodePort/LoadBalancer traffic from the LAN. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: netpol
spec:
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata: { name: startup-zero-allow, namespace: team-a }
      spec:
        podSelector: { matchLabels: { app.kubernetes.io/name: startup-zero } }
        policyTypes: [Ingress]
        ingress:
          - from:
              # same namespace (matched via the auto-applied name label;
              # kube-ovn enforces the policy)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: team-a }
              # the ingress controller, should it run on the pod network (Traefik only,
              # not all of kube-system: nothing else there calls an app)
              - namespaceSelector:
                  matchLabels: { kubernetes.io/metadata.name: kube-system }
                podSelector:
                  matchLabels: { app.kubernetes.io/name: traefik }
              # the kube-ovn join subnet: host-sourced traffic (hostNetwork Traefik
              # dialing the Service's ClusterIP, see its nativelb annotation) arrives
              # as a node join IP (100.64.0.x). Without it ingress traffic is blocked.
              - ipBlock: { cidr: 100.64.0.0/16 }
# NOTE: queues (NATS_URL/OPENINFRA_QUEUES) and secrets (envFrom) are
# injected into the Deployment above; NATS streams are app-declared.
=== worker

---
# --- Deployment ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: deployment
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: worker
        namespace: team-b
        labels: { app.kubernetes.io/name: worker }
      spec:
        selector: { matchLabels: { app.kubernetes.io/name: worker } }
        template:
          metadata:
            labels:
              app.kubernetes.io/name: worker
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: app
                image: ghcr.io/me/worker:1
                # Requests drive the HPA; limits bound the app (tenant). spec.cpu/memory
                # (an ECS container's Cpu/Memory) override the small defaults when set.
                resources:
                  requests: { cpu: 50m, memory: 64Mi }
                  limits: { cpu: 500m, memory: 512Mi }
                env:
                  - { name: MODE, value: "fast" }
                  - { name: Q, value: "say \"hi\"" }
                  - { name: NATS_URL, value: "nats://nats.nats.svc.cluster.local:4222" }
                  - { name: OPENINFRA_QUEUES, value: "orders,events" }
---
# --- HPA ("ASG") — only when there is room to scale (max > min). A fixed-size app
#     (min == max, e.g. {min: 1, max: 1}) gets NO HPA: an HPA with equal bounds has
#     nothing to do and just logs FailedGetResourceMetric/FailedComputeMetricsReplicas.
#     That fixed size is pinned as Deployment.replicas above (= $hpaMin). ---
