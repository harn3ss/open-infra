=== trigger-stream

---
# --- Knative Service: the scale-to-zero "Function" ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: function
spec:
  # Derive readiness from the Knative Service's own Ready condition, NOT the provider default
  # (ready as soon as the Object is CREATED). A revision that fails to come up — crash-looping
  # user container, unloadable handler, bad image — leaves the ksvc Ready=False, so the XR/claim
  # now report NotReady instead of a silently-healthy claim over a broken function. (A scale-to-
  # zero function that only crashes on first activation can still read Ready until then — that
  # residual cold-start case is caught at emit time, not here.)
  readiness:
    policy: DeriveFromCelQuery
    celQuery: has(object.status) && has(object.status.conditions) && object.status.conditions.exists(c, c.type == 'Ready' && c.status == 'True')
  forProvider:
    manifest:
      apiVersion: serving.knative.dev/v1
      kind: Service
      metadata:
        name: trigger-stream
        namespace: team-a
        labels:
          app.kubernetes.io/name: trigger-stream
      spec:
        template:
          metadata:
            annotations:
              # KPA scaling: min 0 = scale to zero when idle.
              autoscaling.knative.dev/min-scale: "0"
              autoscaling.knative.dev/max-scale: "10"
              autoscaling.knative.dev/target: "100"
          spec:
            containers:
              - image: "ghcr.io/me/cdc:1"
                ports: [ { containerPort: 8080 } ]
---
# Event-source mapping: a Benthos "pump" holds a durable JetStream
# consumer and POSTs each CDC event to this function (which cold-starts
# on demand, then scales back to zero). open-infra's Lambda-on-Kinesis.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: pump-config
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: trigger-stream-pump-cfg
        namespace: team-a
      data:
        benthos.yaml: |
          logger: { level: INFO, format: logfmt }
          input:
            nats_jetstream:
              urls: ["nats://nats.nats.svc.cluster.local:4222"]
              subject: "cdc.orders.>"
              durable: "fn-trigger-stream"
              deliver: all
              ack_wait: 2m
          output:
            http_client:
              url: "http://trigger-stream.team-a.svc.cluster.local"
              verb: POST
              timeout: 90s
              headers: { Content-Type: application/json }
---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: pump
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: trigger-stream-pump
        namespace: team-a
        labels: { app: trigger-stream-pump, openinfra.dev/function-pump: "trigger-stream" }
      spec:
        replicas: 1
        selector: { matchLabels: { app: trigger-stream-pump } }
        template:
          # function-invoker: the Kourier gateway's internal listener admits it
          # (platform/serverless/function-gateway-isolation.yaml); it calls only this Function.
          metadata: { labels: { app: trigger-stream-pump, openinfra.dev/function-invoker: pump } }
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: pump
                image: jeffail/benthos:4.27.0
                args: ["-c", "/etc/benthos/benthos.yaml"]
                volumeMounts: [{ name: cfg, mountPath: /etc/benthos }]
            volumes:
              - name: cfg
                configMap: { name: trigger-stream-pump-cfg }
---
# --- Tenant isolation (ingress) for Functions (Knative revision pods): this namespace and
#     Knative's data path only (every call comes through the gateway or the activator, so
#     callers elsewhere still invoke by URL), plus Prometheus; every other namespace is
#     refused, so a Function can no longer be called by pod IP or its private Service from
#     another tenant, skipping Invoke's authorization. One policy per namespace, shared by
#     every Function there (a policy per Function would mean thousands of OVN ACL sets).
#     Each Function renders the same object and none deletes it (no Delete in
#     managementPolicies), so removing one Function leaves the others covered. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: isolation-netpol
spec:
  managementPolicies: ["Observe", "Create", "Update", "LateInitialize"]
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata:
        name: openinfra-function-isolation
        namespace: team-a
        labels: { openinfra.dev/isolation: tenant }
      spec:
        podSelector: { matchExpressions: [ { key: serving.knative.dev/service, operator: Exists } ] }
        policyTypes: [Ingress]
        ingress:
          - from:
              # this namespace
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: team-a } }
              # Knative's data path: the gateway, the activator (scale from zero) and the autoscaler
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: knative-serving } }
              # Prometheus, scraping metrics
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: monitoring } }
                podSelector: { matchLabels: { app.kubernetes.io/name: prometheus } }
=== trigger-subject

---
# --- Knative Service: the scale-to-zero "Function" ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: function
spec:
  # Derive readiness from the Knative Service's own Ready condition, NOT the provider default
  # (ready as soon as the Object is CREATED). A revision that fails to come up — crash-looping
  # user container, unloadable handler, bad image — leaves the ksvc Ready=False, so the XR/claim
  # now report NotReady instead of a silently-healthy claim over a broken function. (A scale-to-
  # zero function that only crashes on first activation can still read Ready until then — that
  # residual cold-start case is caught at emit time, not here.)
  readiness:
    policy: DeriveFromCelQuery
    celQuery: has(object.status) && has(object.status.conditions) && object.status.conditions.exists(c, c.type == 'Ready' && c.status == 'True')
  forProvider:
    manifest:
      apiVersion: serving.knative.dev/v1
      kind: Service
      metadata:
        name: trigger-subject
        namespace: team-a
        labels:
          app.kubernetes.io/name: trigger-subject
      spec:
        template:
          metadata:
            annotations:
              # KPA scaling: min 0 = scale to zero when idle.
              autoscaling.knative.dev/min-scale: "0"
              autoscaling.knative.dev/max-scale: "10"
              autoscaling.knative.dev/target: "100"
          spec:
            containers:
              - image: "ghcr.io/me/cdc:1"
                ports: [ { containerPort: 8080 } ]
---
# Event-source mapping: a Benthos "pump" holds a durable JetStream
# consumer and POSTs each CDC event to this function (which cold-starts
# on demand, then scales back to zero). open-infra's Lambda-on-Kinesis.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: pump-config
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: trigger-subject-pump-cfg
        namespace: team-a
      data:
        benthos.yaml: |
          logger: { level: INFO, format: logfmt }
          input:
            nats_jetstream:
              urls: ["nats://nats.nats.svc.cluster.local:4222"]
              subject: "cdc.orders.public.items"
              durable: "fn-trigger-subject"
              deliver: all
              ack_wait: 2m
          output:
            http_client:
              url: "http://trigger-subject.team-a.svc.cluster.local"
              verb: POST
              timeout: 90s
              headers: { Content-Type: application/json }
---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: pump
spec:
  forProvider:
    manifest:
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: trigger-subject-pump
        namespace: team-a
        labels: { app: trigger-subject-pump, openinfra.dev/function-pump: "trigger-subject" }
      spec:
        replicas: 1
        selector: { matchLabels: { app: trigger-subject-pump } }
        template:
          # function-invoker: the Kourier gateway's internal listener admits it
          # (platform/serverless/function-gateway-isolation.yaml); it calls only this Function.
          metadata: { labels: { app: trigger-subject-pump, openinfra.dev/function-invoker: pump } }
          spec:
            # enableServiceLinks off: per-Service env overflows execve (E2BIG) in dense namespaces; unused here.
            enableServiceLinks: false
            containers:
              - name: pump
                image: jeffail/benthos:4.27.0
                args: ["-c", "/etc/benthos/benthos.yaml"]
                volumeMounts: [{ name: cfg, mountPath: /etc/benthos }]
            volumes:
              - name: cfg
                configMap: { name: trigger-subject-pump-cfg }
---
# --- Tenant isolation (ingress) for Functions (Knative revision pods): this namespace and
#     Knative's data path only (every call comes through the gateway or the activator, so
#     callers elsewhere still invoke by URL), plus Prometheus; every other namespace is
#     refused, so a Function can no longer be called by pod IP or its private Service from
#     another tenant, skipping Invoke's authorization. One policy per namespace, shared by
#     every Function there (a policy per Function would mean thousands of OVN ACL sets).
#     Each Function renders the same object and none deletes it (no Delete in
#     managementPolicies), so removing one Function leaves the others covered. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: isolation-netpol
spec:
  managementPolicies: ["Observe", "Create", "Update", "LateInitialize"]
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata:
        name: openinfra-function-isolation
        namespace: team-a
        labels: { openinfra.dev/isolation: tenant }
      spec:
        podSelector: { matchExpressions: [ { key: serving.knative.dev/service, operator: Exists } ] }
        policyTypes: [Ingress]
        ingress:
          - from:
              # this namespace
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: team-a } }
              # Knative's data path: the gateway, the activator (scale from zero) and the autoscaler
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: knative-serving } }
              # Prometheus, scraping metrics
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: monitoring } }
                podSelector: { matchLabels: { app.kubernetes.io/name: prometheus } }
=== int-typed

---
# --- Knative Service: the scale-to-zero "Function" ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: function
spec:
  # Derive readiness from the Knative Service's own Ready condition, NOT the provider default
  # (ready as soon as the Object is CREATED). A revision that fails to come up — crash-looping
  # user container, unloadable handler, bad image — leaves the ksvc Ready=False, so the XR/claim
  # now report NotReady instead of a silently-healthy claim over a broken function. (A scale-to-
  # zero function that only crashes on first activation can still read Ready until then — that
  # residual cold-start case is caught at emit time, not here.)
  readiness:
    policy: DeriveFromCelQuery
    celQuery: has(object.status) && has(object.status.conditions) && object.status.conditions.exists(c, c.type == 'Ready' && c.status == 'True')
  forProvider:
    manifest:
      apiVersion: serving.knative.dev/v1
      kind: Service
      metadata:
        name: int-typed
        namespace: team-a
        labels:
          app.kubernetes.io/name: int-typed
      spec:
        template:
          metadata:
            annotations:
              # KPA scaling: min 0 = scale to zero when idle.
              autoscaling.knative.dev/min-scale: "0"
              autoscaling.knative.dev/max-scale: "4"
              autoscaling.knative.dev/target: "10"
          spec:
            # Max wall-clock per request (Knative revision timeout) — the AWS Lambda timeout knob.
            timeoutSeconds: 60
            # Max time to the FIRST byte from the handler. Knative defaults this to 300s (its default
            # revision timeout), independently of timeoutSeconds — so a quiet-but-working request (a
            # long report, a batch read, a slow migration step) is silently cut at 300s even when the
            # declared timeout is higher. This is a SECOND 300s boundary, separate from the gateway's
            # idle timeout; raising only the gateway does not move it. Couple it to the declared
            # timeout so the function has ONE deadline — its own — honoured end to end. The Knative
            # webhook requires responseStartTimeoutSeconds <= timeoutSeconds, so they are set equal.
            responseStartTimeoutSeconds: 60
            containers:
              - image: "ghcr.io/me/hello:1"
                ports: [ { containerPort: 8081 } ]
---
# --- Tenant isolation (ingress) for Functions (Knative revision pods): this namespace and
