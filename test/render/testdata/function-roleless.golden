#     Knative's data path only (every call comes through the gateway or the activator, so
#     callers elsewhere still invoke by URL), plus Prometheus; every other namespace is
#     refused, so a Function can no longer be called by pod IP or its private Service from
#     another tenant, skipping Invoke's authorization. One policy per namespace, shared by
#     every Function there (a policy per Function would mean thousands of OVN ACL sets).
#     Each Function renders the same object and none deletes it (no Delete in
#     managementPolicies), so removing one Function leaves the others covered. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: isolation-netpol
spec:
  managementPolicies: ["Observe", "Create", "Update", "LateInitialize"]
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata:
        name: openinfra-function-isolation
        namespace: mirror
        labels: { openinfra.dev/isolation: tenant }
      spec:
        podSelector: { matchExpressions: [ { key: serving.knative.dev/service, operator: Exists } ] }
        policyTypes: [Ingress]
        ingress:
          - from:
              # this namespace
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: mirror } }
              # Knative's data path: the gateway, the activator (scale from zero) and the autoscaler
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: knative-serving } }
              # Prometheus, scraping metrics
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: monitoring } }
                podSelector: { matchLabels: { app.kubernetes.io/name: prometheus } }
=== code-runtimeimage-allowegress

---
# --- Knative Service: the scale-to-zero "Function" ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: function
spec:
  # Derive readiness from the Knative Service's own Ready condition, NOT the provider default
  # (ready as soon as the Object is CREATED). A revision that fails to come up — crash-looping
  # user container, unloadable handler, bad image — leaves the ksvc Ready=False, so the XR/claim
  # now report NotReady instead of a silently-healthy claim over a broken function. (A scale-to-
  # zero function that only crashes on first activation can still read Ready until then — that
  # residual cold-start case is caught at emit time, not here.)
  readiness:
    policy: DeriveFromCelQuery
    celQuery: has(object.status) && has(object.status.conditions) && object.status.conditions.exists(c, c.type == 'Ready' && c.status == 'True')
  forProvider:
    manifest:
      apiVersion: serving.knative.dev/v1
      kind: Service
      metadata:
        name: code-runtimeimage-allowegress
        namespace: mirror
        labels:
          app.kubernetes.io/name: code-runtimeimage-allowegress
          # Unsupported/EOL runtime kept only as a comparison fixture — never production.
          openinfra.dev/non-production: "true"
          # Private: only reachable from inside the cluster.
          networking.knative.dev/visibility: cluster-local
      spec:
        template:
          metadata:
            annotations:
              # KPA scaling: min 0 = scale to zero when idle.
              autoscaling.knative.dev/min-scale: "0"
              # Burstable / Lambda admission model: one request per instance (containerConcurrency
              # 1 below), per-function ceiling = scaling.max (the reserved-concurrency analog). The
              # ACCOUNT total is capped by a per-tenant quota (docs/function-admission.md).
              autoscaling.knative.dev/max-scale: "10"
              autoscaling.knative.dev/target: "1"
              # Queue-proxy sidecar sizing (honored only with config-features
              # queueproxy.resource-defaults: enabled, set in platform/serverless/knative-serving.yaml):
              # give the sidecar an explicit small request + limit so the pod's reservation is the
              # function floor plus a KNOWN sidecar cost, and so a per-tenant requests.memory quota
              # (which requires every in-scope container to declare a memory request) never rejects
              # the pod for a request-less sidecar. Inert on non-burstable revisions (no annotation).
              queue.sidecar.serving.knative.dev/cpu-resource-request: "25m"
              queue.sidecar.serving.knative.dev/memory-resource-request: "32Mi"
              queue.sidecar.serving.knative.dev/memory-resource-limit: "64Mi"
          spec:
            # One request per instance (Lambda's 1-per-sandbox model): set by reservedConcurrency
            # (hard per-function cap) OR burstable (so a running pod == one in-flight request ==
            # the "concurrent executions" unit the per-tenant concurrency quota counts).
            containerConcurrency: 1
            # The function's own Timeout (Lambda's, default 300 here) is enforced by its runtime,
            # counted from when the invoke reaches it, as Lambda counts it once init is done
            # (OPENINFRA_TIMEOUT_S below). Knative's deadline counts from the request's arrival,
            # including the wait for an instance started from zero, so it is the timeout plus the
            # start-up allowance (the aws-shim's invokeColdStartAllowance, 90 s): a cold start never
            # spends the function's own time (#413). max-revision-timeout-seconds (knative-serving.yaml)
            # is the XRD's 900 plus the same allowance. Knative's response-start timeout (time to the
            # FIRST byte) defaults to 300 s independently, so it is set to the same deadline.
            timeoutSeconds: 390
            responseStartTimeoutSeconds: 390
            # Burstable function pods are overcommitted, so they must lose first under node memory
            # pressure — not MinIO, databases, or the control plane (which stay Guaranteed and
            # higher-priority). openinfra-function is below default workloads and non-preempting, so
            # scheduling a function never evicts anything else. See function-priorityclass.yaml.
            priorityClassName: openinfra-function
            containers:
              - image: "ecr-registry.open-infra-ecr.svc:5000/runtime/python37:latest"
                ports: [ { containerPort: 8080 } ]
                env:
                  - { name: OPENINFRA_HANDLER, value: "lambda_function.lambda_handler" }
                  - { name: OPENINFRA_FUNCTION_NAME, value: "code-runtimeimage-allowegress" }
                  # The function's Timeout, which the runtime enforces from each invoke's arrival.
                  - { name: OPENINFRA_TIMEOUT_S, value: "300" }
                  - { name: OPENINFRA_CODE_BUCKET, value: "mirror-code" }
                  - { name: OPENINFRA_CODE_KEY, value: "code/9b1c.zip" }
                  # AWS Lambda reserved runtime variables — AWS's own runtime injects these and a
                  # handler relies on them (e.g. an SDK client needs a region). They can't be set
                  # as function env because AWS reserves the names, so the runtime must inject them.
                  - { name: AWS_REGION, value: "us-east-1" }
                  - { name: AWS_DEFAULT_REGION, value: "us-east-1" }
                  - { name: AWS_LAMBDA_FUNCTION_NAME, value: "code-runtimeimage-allowegress" }
                  - { name: AWS_LAMBDA_FUNCTION_VERSION, value: "$LATEST" }
                  - { name: AWS_LAMBDA_LOG_GROUP_NAME, value: "/aws/lambda/code-runtimeimage-allowegress" }
                  - { name: LAMBDA_TASK_ROOT, value: "/var/task" }
                  - { name: LAMBDA_RUNTIME_DIR, value: "/var/runtime" }
                  - { name: TZ, value: "UTC" }
                  # DynamoDB data plane: the aws-shim's DynamoDB endpoint (FerretDB / DocumentDB-Postgres
                  # backed). Service-scoped — AWS_ENDPOINT_URL_DYNAMODB redirects ONLY the handler's DynamoDB
                  # client; every other AWS service keeps its default resolution (a global AWS_ENDPOINT_URL
                  # would wrongly capture them all). A handler that never calls DynamoDB is unaffected.
                  - { name: AWS_ENDPOINT_URL_DYNAMODB, value: "http://aws-shim.open-infra-aws-shim.svc.cluster.local:4566" }
                  # Code-source creds mapped EXPLICITLY (not envFrom) so the S3/MinIO endpoint is
                  # the service-scoped AWS_ENDPOINT_URL_S3, never the global AWS_ENDPOINT_URL (a
                  # global override would point every service — dynamodb, sns, … — at the S3
                  # gateway). The shim reads AWS_ENDPOINT_URL_S3 for its own code fetch.
                  - { name: AWS_ACCESS_KEY_ID, valueFrom: { secretKeyRef: { name: mirror-code-read, key: AWS_ACCESS_KEY_ID, optional: true } } }
                  - { name: AWS_SECRET_ACCESS_KEY, valueFrom: { secretKeyRef: { name: mirror-code-read, key: AWS_SECRET_ACCESS_KEY, optional: true } } }
                  - { name: AWS_ENDPOINT_URL_S3, valueFrom: { secretKeyRef: { name: mirror-code-read, key: AWS_ENDPOINT_URL, optional: true } } }
                # memory → the AWS Lambda memory knob (also the per-invocation ceiling); gpu → device limit.
                # Default (burstable false): request == limit == memory → Guaranteed QoS, so the full
                # configured memory is RESERVED even while the pod is warm and idle. burstable true:
                # request = per-runtime floor ($memReq), limit = memory → Burstable QoS; the pod still
                # bursts to the full limit for an invocation but reserves far less when warm. This is
                # the reservation-not-use fix — see docs/function-admission.md.
                resources:
                  requests: { memory: "128Mi" }
                  limits:
                    memory: "512Mi"
---
# --- Tenant isolation (ingress) for Functions (Knative revision pods): this namespace and
#     Knative's data path only (every call comes through the gateway or the activator, so
#     callers elsewhere still invoke by URL), plus Prometheus; every other namespace is
#     refused, so a Function can no longer be called by pod IP or its private Service from
#     another tenant, skipping Invoke's authorization. One policy per namespace, shared by
#     every Function there (a policy per Function would mean thousands of OVN ACL sets).
#     Each Function renders the same object and none deletes it (no Delete in
#     managementPolicies), so removing one Function leaves the others covered. ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: isolation-netpol
spec:
  managementPolicies: ["Observe", "Create", "Update", "LateInitialize"]
  forProvider:
    manifest:
      apiVersion: networking.k8s.io/v1
      kind: NetworkPolicy
      metadata:
        name: openinfra-function-isolation
        namespace: mirror
        labels: { openinfra.dev/isolation: tenant }
      spec:
        podSelector: { matchExpressions: [ { key: serving.knative.dev/service, operator: Exists } ] }
        policyTypes: [Ingress]
        ingress:
          - from:
              # this namespace
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: mirror } }
              # Knative's data path: the gateway, the activator (scale from zero) and the autoscaler
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: knative-serving } }
              # Prometheus, scraping metrics
              - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: monitoring } }
                podSelector: { matchLabels: { app.kubernetes.io/name: prometheus } }
=== versions

---
# --- Knative Service: the scale-to-zero "Function" ---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: function
spec:
  # Derive readiness from the Knative Service's own Ready condition, NOT the provider default
  # (ready as soon as the Object is CREATED). A revision that fails to come up — crash-looping
  # user container, unloadable handler, bad image — leaves the ksvc Ready=False, so the XR/claim
  # now report NotReady instead of a silently-healthy claim over a broken function. (A scale-to-
  # zero function that only crashes on first activation can still read Ready until then — that
  # residual cold-start case is caught at emit time, not here.)
  readiness:
    policy: DeriveFromCelQuery
    celQuery: has(object.status) && has(object.status.conditions) && object.status.conditions.exists(c, c.type == 'Ready' && c.status == 'True')
  forProvider:
    manifest:
      apiVersion: serving.knative.dev/v1
      kind: Service
      metadata:
        name: versions
        namespace: team-a
        labels:
          app.kubernetes.io/name: versions
      spec:
        template:
          metadata:
            annotations:
              # KPA scaling: min 0 = scale to zero when idle.
              autoscaling.knative.dev/min-scale: "0"
              autoscaling.knative.dev/max-scale: "10"
              autoscaling.knative.dev/target: "100"
          spec:
            containers:
              - image: "ghcr.io/me/hello:3"
                ports: [ { containerPort: 8080 } ]
        # Published versions: all traffic on the latest revision ($LATEST), each version kept
        # and addressable at its tag v<version>.
        traffic:
          - latestRevision: true
            percent: 100
          - tag: "v1"
            revisionName: "fn-00001"
            percent: 0
---
