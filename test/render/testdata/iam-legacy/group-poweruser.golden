
---
# Bind openinfra:<name> to the requested ClusterRole. Note this grants to a
# GROUP STRING, not to an object: Kubernetes users/groups are assertions made
# by the authenticator (here, the console's impersonation headers), which is
# why the console's ability to impersonate is pinned to the openinfra:* groups.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: group-binding
spec:
  forProvider:
    manifest:
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: openinfra-group-builders
        labels:
          openinfra.dev/iam-group: builders
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: "open-infra-poweruser"
      subjects:
        - kind: Group
          name: "openinfra:builders"
          apiGroup: rbac.authorization.k8s.io
---
apiVersion: iam.openinfra.dev/v1
kind: XGroup
status:
  ready: true
  boundTo: "openinfra:builders"