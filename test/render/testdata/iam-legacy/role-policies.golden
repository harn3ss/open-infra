
---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: role-clusterrole
spec:
  forProvider:
    manifest:
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
        name: openinfra-role-app
        labels:
          rbac.openinfra.dev/managed: role
          openinfra.dev/iam-role: app
      # An empty clusterRoleSelectors matches nothing, so a role with no
      # policies attached grants nothing until one is added.
      aggregationRule:
        clusterRoleSelectors:
                      - matchLabels:
                          rbac.openinfra.dev/policy-app-access: true
                      - matchLabels:
                          rbac.openinfra.dev/policy-aws-amazonssmmanagedinstancecore: true
---
apiVersion: iam.openinfra.dev/v1
kind: XRole
status:
  ready: true
  clusterRole: openinfra-role-app