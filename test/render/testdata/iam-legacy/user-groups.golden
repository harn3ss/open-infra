
---
# A label-selected spec-mirror ConfigMap the console can read without CRD access —
# AND it makes this pipeline emit a composed resource, which is what lets the
# go-templating function actually apply the composite status below. A status-only
# composition (no composed resources) never gets its status written, so the User's
# `status.ready` never lands and nothing that gates on readiness (the cfn engine,
# tooling) ever proceeds. Mirrors the EncryptionKey composition.
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: user-spec
spec:
  forProvider:
    manifest:
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: openinfra-user-alice
        namespace: open-infra-console
        labels:
          openinfra.dev/user: alice
      data:
        name: "alice"
        displayName: "Alice"
        source: "local"
        disabled: "false"
        groups: "[\"admins\"]"
---
# No RBAC is emitted here on purpose — see the header. Identity + status only.
apiVersion: iam.openinfra.dev/v1
kind: XUser
status:
  ready: true
  # toJson always emits a valid array ([] when empty). A bare range left this `null`
  # for a group-less user, which fails the XRD's array schema and made the ENTIRE
  # status-apply error out — so status.ready never landed.
  groups: ["admins"]